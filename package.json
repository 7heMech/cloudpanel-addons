{
  "name": "cloudpanel-addons",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "preview:ui": "bun --watch tools/preview-ui.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.tools.json",
    "typecheck:tools": "tsc --noEmit --project tsconfig.tools.json",
    "build": "bun build --compile --target=bun-linux-x64 --bytecode --minify --format=esm --outfile dist/clp-addons-linux-x64 cli/index.ts",
    "lint:install": "shellcheck -S warning install.sh",
    "test": "bun test --max-concurrency=1 && bun run test:supplemental",
    "test:supplemental": "bun tools/test-panel-snapshot.ts && bun tools/test-phase1.ts && bun tools/test-builtins.ts && bun tools/test-stager-spawn.ts",
    "test:app": "bun test ./tools/test-app.test.ts",
    "test:delete": "bun test ./tools/test-delete.test.ts",
    "test:inject": "bun test ./tools/test-inject.test.ts",
    "test:installer": "bun tools/integration-installer-picker.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
