{
  "name": "cloudpanel-addons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --target=bun-linux-x64 --outfile dist/clp-addons-linux-x64 cli/index.ts",
    "lint:wrapper": "shellcheck -S warning addons/*/wrapper/* tools/*.sh install.sh",
    "test:app": "bun tools/test-app.ts",
    "test:certificate": "bun tools/test-certificate.ts",
    "test:delete": "bun tools/test-delete.ts",
    "test:inject": "bun tools/test-inject.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
