{
  "name": "cloudpanel-addons",
  "version": "1.4.3",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "preview:ui": "bun --watch tools/preview-ui.ts",
    "preview:shot": "bun tools/ui-shot.ts",
    "deploy:stg": "bun tools/deploy-stg.ts",
    "typecheck": "tsc --noEmit --project tsconfig.tools.json",
    "build": "bun build --compile --target=bun-linux-x64 --bytecode --minify --format=esm --outfile dist/clp-addons-linux-x64 cli/index.ts",
    "lint:install": "shellcheck -S warning install.sh",
    "test": "bun test --isolate --max-concurrency=1",
    "test:app": "bun test ./tests/test-app.test.ts",
    "test:delete": "bun test ./tests/test-delete.test.ts",
    "test:inject": "bun test ./tests/test-inject.test.ts",
    "test:installer": "bun tests/integration/integration-installer-picker.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
