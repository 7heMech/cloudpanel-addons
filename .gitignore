# Build output
dist/
node_modules/
*.tsbuildinfo

# Never commit: on a production clone the recon output names real customer
# domains and real site users.
recon*.txt

# Never commit: CloudPanel's Twig templates are proprietary, patched or not.
# The injection routine snapshots them to /var/lib/clp-addons at runtime.
*.twig
*.pristine

# Never commit: panel state, credentials, keys.
*.sq3
*.db
*.sqlite
.env
.env.*
!.env.example
*.pem
*.key
SHA256SUMS
