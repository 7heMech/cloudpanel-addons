#!/usr/bin/env bash
set -euo pipefail

readonly SESSION_DIR="/var/lib/php/sessions"

invalid() {
  printf '%s\n' '{"valid":false}'
  exit 0
}

(( $# == 1 )) || invalid
case "$1" in
  --cookie=*) session_id=${1#*=} ;;
  *) invalid ;;
esac
[[ -n ${session_id:-} && $session_id =~ ^[a-zA-Z0-9,-]+$ ]] || invalid

session_file="${SESSION_DIR}/sess_${session_id}"
[[ -s $session_file ]] || invalid
session_data=$(<"$session_file") || invalid

meta_re='_sf2_meta\|a:[0-9]+:\{([^}]*)\}'
[[ $session_data =~ $meta_re ]] || invalid
meta=${BASH_REMATCH[1]}

updated_re='s:1:"u";i:([0-9]+)'
lifetime_re='s:1:"l";i:([0-9]+)'
[[ $meta =~ $updated_re ]] || invalid
updated=${BASH_REMATCH[1]}
[[ $meta =~ $lifetime_re ]] || invalid
lifetime=${BASH_REMATCH[1]}
if (( lifetime == 0 )); then
  lifetime=1440
fi
(( lifetime > 0 )) || invalid

now=$(date +%s)
(( now <= updated + lifetime )) || invalid

token_re='_security_[^|]+\|[^|]*authenticated";b:1'
[[ $session_data =~ $token_re ]] || invalid

user=""
user_re='s:4:"user";s:[0-9]+:"([A-Za-z0-9_.@-]+)"'
if [[ $session_data =~ $user_re ]]; then
  user=${BASH_REMATCH[1]}
else
  user_re='user";s:[0-9]+:"([A-Za-z0-9_.@-]+)"'
  if [[ $session_data =~ $user_re ]]; then
    user=${BASH_REMATCH[1]}
  else
    username_re='username";s:[0-9]+:"([A-Za-z0-9_.@-]+)"'
    [[ $session_data =~ $username_re ]] || invalid
    user=${BASH_REMATCH[1]}
  fi
fi
[[ -n $user ]] || invalid

printf '{"valid":true,"user":"%s"}\n' "$user"
