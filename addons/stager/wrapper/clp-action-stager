#!/usr/bin/env bash
# =============================================================================
# clp-action-stager
#
# The privilege boundary for the Stager addon. Runs as root via a single
# sudoers line granting the unprivileged app user this one script and nothing
# else. Everything this script permits, the app user can do as root, so the
# argument validation below is the whole security model.
#
# Rules this file must keep (see docs/DECISIONS.md):
#   - validate before acting, and reject rather than sanitize
#   - build argv arrays and exec directly; never sh -c, eval, or backticks
#   - no free-form arguments: no paths, no filenames, no SQL
#   - machine-readable JSON on stdout, human-readable progress on stderr
#
# What it clones: php, static and reverse-proxy sites. A reverse-proxy site is
# only clonable when its backend is an Instatic instance this box manages,
# because duplicating the hostname alone would point a staging site at the live
# application; the content moves through Instatic's own site-bundle export and
# import, and the clone gets a container, a port and a master key of its own.
#
# How it carries the source's hand-edited nginx config, and why that is two
# different mechanisms. For a php source the clone is created from a throwaway
# named vhost template, so CloudPanel does all the writing -- that is the route
# to prefer and it is tried first. For every other type there is no such route:
# `site:add:php` is the only `site:add:*` verb with a --vhostTemplate option, so
# the choice is between writing the panel record ourselves and shipping a
# staging site whose nginx config is not the one being tested.
#
# So this file does write panel state, in exactly one place and under guards
# that are the whole justification (see "Carrying a site's vhost to its clone"
# in docs/DECISIONS.md): one UPDATE, one column pair, one row, only for a site
# this job created seconds ago, run as `clp` rather than as root, with both
# written values reaching sqlite through readfile() so that nothing a caller
# influenced is ever interpolated into SQL at all, and read back and compared
# before the job calls it done. The file on
# disk is written and `nginx -t`-ed first, so the database is never left
# describing a config nginx rejected, and any failure restores the stock vhost
# and reports why rather than losing the clone.
# =============================================================================
set -euo pipefail

readonly LOCK_DIR="/run/lock/clp-addons"
readonly DATA_BASE_DIR="/var/lib/clp-addons/stager"
readonly JOBS_DIR="${DATA_BASE_DIR}/jobs"
readonly ADDON_CONFIG="/etc/clp-addons/stager.conf"
readonly PANEL_DB="/home/clp/htdocs/app/data/db.sq3"
readonly CLPCTL="/usr/bin/clpctl"

# Confirmed against Creator::NGINX_VHOST_DIRECTORY in the panel's own source.
# Files there are root:root 0644 and the panel rewrites them from
# `site.vhost_template` whenever it regenerates a site.
readonly NGINX_VHOST_DIR="/etc/nginx/sites-enabled"

# The sibling addon's boundary, reached by absolute path for the same reason
# SELF is hardcoded: it is the copy the sudoers line names and the only one
# that has been reviewed. Absent when the Stager is installed on its own, which
# is a refusal rather than a fallback.
readonly INSTATIC_WRAPPER="/usr/local/lib/clp-addons/clp-action-instatic"
readonly INSTATIC_DATA_DIR="/var/lib/clp-addons/instatic"

# One list, and every gate reads from it. Node.js and Python sites are a
# `site:add:*` verb away but neither exists on the box this was built against,
# and an untested clone path that creates real sites is worse than an honest
# refusal.
readonly CLONABLE_TYPES=(php static reverse-proxy)

# Instatic instances live in the block decision 2.11 reserves. The port is
# proposed by the app, which reads the panel snapshot, and re-validated here.
readonly PORT_MIN=39000
readonly PORT_MAX=39999

# Hardcoded rather than "$0". The sudoers line names this exact path, so it is
# the only copy of this script that has been reviewed and granted anything;
# re-entering through $0 would follow whatever path the caller was invoked by.
readonly SELF="/usr/local/lib/clp-addons/clp-action-stager"

# Job records outlive the clone because they carry the staging database
# password, which is the one credential the operator cannot read back out of
# the panel. Long enough to be useful, short enough that the box is not a
# permanent store of them.
readonly JOB_RETENTION_DAYS=14
readonly LOG_TAIL_LINES=400

log()  { printf '[stager] %s\n' "$*" >&2; }
warn() { printf '[stager] WARN: %s\n' "$*" >&2; }

# stdout is a machine-readable contract. Everything else goes to stderr.
emit_ok() {
  printf '{"ok":true,"data":%s}\n' "${1:-null}"
}

emit_err() {
  local msg="$1"
  printf '[stager] ERROR: %s\n' "$msg" >&2
  printf '{"ok":false,"error":%s}\n' "$(json_str "$msg")"
  exit 1
}

# Quote a string as a JSON scalar without shelling out to jq, so the error path
# still works on a box where jq is missing.
json_str() {
  local s=${1//$'\033'/}
  s=$(printf '%s' "$s" | tr -d '\000-\010\013\014\016-\037')
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/\\r}
  printf '"%s"' "$s"
}

# One field out of a flat JSON object, without a JSON parser, so the error path
# still works on a box where jq is missing. Only ever pointed at documents this
# project's own wrappers wrote -- an instance's meta.json and the reply from the
# Instatic wrapper's own stdout contract -- which is what makes a sed defensible
# where a parser would otherwise be owed.
json_field() {
  local file=$1 field=$2
  [[ -f $file ]] || return 1
  sed -n "s/.*\"${field}\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p" "$file" | head -1
}

# --- validation -------------------------------------------------------------
# Every one of these rejects. None of them rewrite their input.

validate_domain() {
  local d=$1 what=$2
  [[ -n $d ]] || emit_err "missing --${what}"
  (( ${#d} <= 253 )) || emit_err "the --${what} domain is too long"
  local re='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$'
  [[ $d =~ $re ]] || emit_err "invalid domain for --${what}: '$d'"

  # Neither end of a clone may be the site serving this addon: as a source it
  # would copy the manager's own credentials into a new site, and as a target
  # it would hand the manager's vhost to a clone of something else.
  if [[ -r $ADDON_CONFIG ]]; then
    local own
    # Read the value, never source the file: sourcing turns a config write into
    # root code execution.
    own=$(sed -n 's/^[[:space:]]*OWN_DOMAIN[[:space:]]*=[[:space:]]*"\?\([^"#]*\)"\?.*/\1/p' \
          "$ADDON_CONFIG" | tail -1 | tr -d '[:space:]')
    if [[ -n $own && $d == "$own" ]]; then
      emit_err "refusing to act on the addon's own site: '$d'"
    fi
  fi
  return 0
}

# Generated here and only here, so the format is fixed rather than something a
# caller proposes: a job id reaches the filesystem as a directory name.
validate_job() {
  local j=$1
  [[ -n $j ]] || emit_err "missing --job"
  [[ $j =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$ ]] || emit_err "invalid job id: '$j'"
  return 0
}

validate_flag() {
  local v=$1 what=$2
  [[ $v == "yes" || $v == "no" ]] || emit_err "--${what} takes yes or no, got: '$v'"
  return 0
}

# Only ever reached for an Instatic clone, where it becomes a published port
# and part of a container's configuration.
validate_port() {
  local p=$1
  [[ -n $p ]] || emit_err "missing --port"
  [[ $p =~ ^[0-9]{1,5}$ ]] || emit_err "port must be an integer: '$p'"
  (( 10#$p >= PORT_MIN && 10#$p <= PORT_MAX )) \
    || emit_err "port $p outside the reserved range ${PORT_MIN}-${PORT_MAX}"
  return 0
}

# The source instance's admin address. It identifies an account on another
# service rather than anything on this box, so the only thing this can do is
# reject a shape Instatic itself would reject.
validate_email() {
  local e=$1
  [[ -n $e ]] || emit_err "missing --email"
  (( ${#e} <= 254 )) || emit_err "--email is too long"
  [[ $e =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$ ]] \
    || emit_err "invalid email address: '$e'"
  return 0
}

# TOTP or a recovery code, both of which Instatic accepts on the same field.
validate_mfa() {
  local c=$1
  [[ $c =~ ^[A-Za-z0-9-]{6,32}$ ]] || emit_err "the authentication code has an unexpected shape"
  return 0
}

# The name of a CloudPanel vhost template, which is what `site.application`
# holds. A predicate rather than an emit_err validator, because the callers
# degrade to the stock template name instead of losing the clone over a label.
#
# This is not cosmetic. `application` originates in `site.application` of the
# *source* site, read straight out of the panel, and it reaches SQL --
# `panel_update_site` and `vhost_template_exists` both put a name in a
# statement. CloudPanel does nothing to earn that trust:
# `VhostTemplateAddCommand` stores `trim($input->getOption("name"))` with no
# character check, `SiteAddPhpCommand` copies that name into `site.application`
# verbatim, and `/etc/sudoers.d/cloudpanel` lets every local account run
# `clpctlWrapper`. So any local user could register a template whose *name* is
# a SQL payload, create a php site from it and have a clone of that site run it.
# Reproduced against a throwaway database: `Generic', user = 'root` rewrote
# `site.user` to root, and because `sqlite3 -readonly` still has fileio compiled
# in, `SELECT writefile(...)` in the read-back was an arbitrary root write.
#
# The accepted set is measured, not guessed. Every one of the 31 stock template
# names on this box and every `site.application` value in its `site` table uses
# only letters, digits, space, dot and hyphen -- `PrestaShop 1.7` is what forces
# the dot and `clp-stager-src2` the hyphen. Underscore is admitted beside them
# because it is equally inert -- none of these can close a SQL string literal --
# and an operator naming a custom template plausibly types one. Anything else is
# refused rather than escaped, so the value that reaches SQL is one that could
# not carry a payload however it got into the panel.
application_ok() {
  local a=$1
  # In a variable, like every other pattern here, because a bracket expression
  # is POSIX and takes no backslash escapes: writing the space as `\ ` inline
  # would admit a literal backslash into the accepted set.
  local re='^[A-Za-z0-9]([A-Za-z0-9 ._-]{0,62}[A-Za-z0-9])?$'
  [[ $a =~ $re ]] || return 1
  return 0
}

# Membership rather than equality, so adding a type is one line here and
# nothing else has to be found.
type_is_clonable() {
  local t=$1 c
  for c in "${CLONABLE_TYPES[@]}"; do
    if [[ $t == "$c" ]]; then return 0; fi
  done
  return 1
}

# --- panel reads ------------------------------------------------------------
# Read-only, always. The domain has passed validate_domain by the time it
# reaches any of these, so it holds nothing but [a-z0-9.-]; sqlite3's CLI has
# no bind parameters, and that validation gate is what makes the interpolation
# safe.

panel_query() {
  [[ -r $PANEL_DB ]] || return 1
  sqlite3 -readonly "$PANEL_DB" "$1" 2>/dev/null
}

site_exists() {
  local n
  n=$(panel_query "SELECT COUNT(*) FROM site WHERE domain_name = '$1';") || return 1
  [[ ${n:-0} -gt 0 ]]
}

# type|user|root_directory|application for one site, or nothing.
site_row() {
  panel_query "SELECT type, user, root_directory, COALESCE(application, '') FROM site WHERE domain_name = '$1';"
}

php_version_of() {
  panel_query "SELECT p.php_version FROM php_settings p JOIN site s ON s.id = p.site_id WHERE s.domain_name = '$1';"
}

database_of() {
  panel_query "SELECT d.name FROM database d JOIN site s ON s.id = d.site_id WHERE s.domain_name = '$1' ORDER BY d.id LIMIT 1;"
}

vhost_of() {
  panel_query "SELECT vhost_template FROM site WHERE domain_name = '$1';"
}

application_of() {
  panel_query "SELECT COALESCE(application, '') FROM site WHERE domain_name = '$1';"
}

reverse_proxy_url_of() {
  panel_query "SELECT COALESCE(reverse_proxy_url, '') FROM site WHERE domain_name = '$1';"
}

# --- naming -----------------------------------------------------------------

# The one scheme for accounts CloudPanel creates for this project. Reimplemented
# from cli/provision.ts, which is TypeScript and cannot be imported here; a test
# runs both over a list of domains and asserts they agree. Hashing the whole
# domain is what keeps it unique -- earlier schemes truncated the domain, and
# site.user is UNIQUE, so two sites sharing a prefix collided inside clpctl.
site_user_for() {
  local d=${1,,} readable hash
  readable=${d//[^a-z0-9]/}
  readable=${readable:0:8}
  hash=$(printf '%s' "$d" | sha256sum | cut -c1-6)
  printf 'addon-%s-%s' "$readable" "$hash"
}

# Derived from the target domain rather than random, so a retry after a failed
# clone proposes the same names and "already exists" means something.
db_name_for() {
  local d=${1,,} readable hash
  readable=${d//[^a-z0-9]/}
  readable=${readable:0:8}
  hash=$(printf '%s' "$d" | sha256sum | cut -c1-6)
  printf 'stg%s%s' "$readable" "$hash"
}

db_user_for() {
  local d=${1,,} readable hash
  readable=${d//[^a-z0-9]/}
  readable=${readable:0:8}
  hash=$(printf '%s' "$d" | sha256sum | cut -c1-6)
  printf 'u%s%s' "$readable" "$hash"
}

user_taken() {
  getent passwd "$1" >/dev/null 2>&1
}

# CloudPanel requires an upper, a lower, a digit and a symbol. Everything after
# the fixed prefix is [A-Za-z0-9], which also keeps it safe to place in a sed
# replacement when it is written into wp-config.php.
gen_password() {
  local raw
  raw=$(head -c 24 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9')
  printf 'Aa1%s!' "${raw:0:16}"
}

# No symbols at all: this one is interpolated into wp-config.php and .env
# through sed, where & and \ are replacement metacharacters.
gen_db_password() {
  head -c 24 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 24
}

# --- job records ------------------------------------------------------------
# One small file per field rather than one JSON document that every step
# rewrites. A partial write then costs one field instead of the whole record,
# and bash can set a field with a single redirect.

job_dir() { printf '%s/%s' "$JOBS_DIR" "$1"; }

job_set() {
  local dir=$1 field=$2 value=$3
  printf '%s\n' "$value" > "${dir}/${field}"
  chmod 600 "${dir}/${field}"
}

job_get() {
  local dir=$1 field=$2
  [[ -f "${dir}/${field}" ]] && head -c 4096 "${dir}/${field}" | tr -d '\n' || true
}

new_job_id() {
  printf '%s-%s' "$(date -u +%Y%m%dT%H%M%SZ)" "$(openssl rand -hex 3)"
}

# --- clone steps ------------------------------------------------------------

# Progress and unwind state for one clone. Globals rather than locals because
# the EXIT trap that rolls a failed clone back runs outside cmd_run's scope.
STEP=""
JOB_DIR=""
# Did this job create the CloudPanel *site*? It gates the one panel write, so
# "yes" has to mean the row was made seconds ago and belonged to nobody before.
# It is not the same question as whether anything was created at all: the
# Instatic wrapper adopts a matching pre-existing reverse-proxy site rather than
# failing, and keeps its own site_created=0 so its cleanup never deletes a site
# that was already serving something. Taking a zero exit status as "created"
# threw that answer away.
SITE_CREATED=0
# Did this job create the Instatic *instance* -- the container and the data
# directory -- so that unwinding means going back through the Instatic wrapper
# rather than deleting the CloudPanel site out from under it? A separate
# question from the one above, because that wrapper refuses outright if the
# container or meta.json already exist, so a successful create always made the
# instance even when it only adopted the site. Its own `delete` then removes
# exactly what it made and leaves an adopted site alone.
SITE_VIA_INSTATIC=0
DB_CREATED=0
DUMP_FILE=""
STG_DB_NAME=""
STG_DB_USER=""
STG_DB_PASS=""
TEMPLATE_NAME=""

set_step() {
  STEP=$1
  [[ -n $JOB_DIR ]] && job_set "$JOB_DIR" step "$1"
  log "$1"
}

fail_job() {
  local msg=$1
  if [[ -n $JOB_DIR ]]; then
    job_set "$JOB_DIR" error "$msg"
    job_set "$JOB_DIR" state failed
  fi
  printf '[stager] ERROR: %s\n' "$msg" >&2
  exit 1
}

cmd_run() {
  local id=$1
  local dir; dir=$(job_dir "$id")
  [[ -d $dir ]] || emit_err "no such job: ${id}"
  JOB_DIR=$dir

  # Everything from here is the job's transcript. The caller is systemd, which
  # would otherwise put a staging database password into the journal.
  exec >>"${dir}/log" 2>&1
  chmod 600 "${dir}/log"

  local source target tls port email mfa
  source=$(job_get "$dir" source)
  target=$(job_get "$dir" target)
  tls=$(job_get "$dir" tls)
  port=$(job_get "$dir" port)
  email=$(job_get "$dir" email)
  mfa=$(job_get "$dir" mfa)
  [[ -n $source && -n $target ]] || fail_job "job record is incomplete"

  # Re-validated rather than trusted: this file was written by an earlier run of
  # this script, but a job directory is still a file on disk. That applies to
  # the port and the address as much as to the hostnames -- the port becomes a
  # published container port and part of the clone's proxy URL.
  validate_domain "$source" source
  validate_domain "$target" target
  validate_job "$id"
  if [[ -n $port ]];  then validate_port "$port"; fi
  if [[ -n $email ]]; then validate_email "$email"; fi
  if [[ -n $mfa ]];   then validate_mfa "$mfa"; fi

  local state; state=$(job_get "$dir" state)
  [[ $state == "queued" ]] || fail_job "job ${id} is ${state}, not queued"

  # Re-checked here and not only in `clone`. That verb refuses a target that
  # already exists, but it releases the target's lock before handing the work to
  # systemd -- deliberately, because holding it deadlocked the two against each
  # other -- so a site can appear in the window between. Every guard below that
  # says "a site this job created" rests on nothing having created it first, and
  # this is the only place under the lock where that can still be established.
  if site_exists "$target"; then
    fail_job "a CloudPanel site for ${target} appeared after this clone was queued; nothing was changed"
  fi

  job_set "$dir" state running
  job_set "$dir" startedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  rollback() {
    local rc=$?
    (( rc == 0 )) && return 0
    warn "clone failed during '${STEP}', unwinding"
    [[ -n $DUMP_FILE && -f $DUMP_FILE ]] && rm -f "$DUMP_FILE"
    # A session this run opened is revoked rather than left to expire, and that
    # has to hold when the clone fails -- which is exactly when it did not.
    # Instatic's absolute session timeout is 90 days, so a failure between login
    # and export used to leave a live administrator session on the production
    # instance with its token sitting in the job directory for the fourteen days
    # a record is kept. A clone leaves nothing live on the site it copied.
    if [[ -n ${src_port:-} && -f "${dir}/cookies-src" ]]; then
      warn "revoking the session this run opened on ${source}"
      instatic_logout "${src_port}" "$source" "${dir}/cookies-src"
    fi
    if [[ -n ${port:-} && -f "${dir}/cookies-dst" ]]; then
      instatic_logout "${port}" "$target" "${dir}/cookies-dst"
    fi
    # The source instance's credentials, the bundle taken with them and the
    # cookie jars holding their sessions never outlive the run, however it ends.
    # The authentication code is in that list because validate_mfa deliberately
    # accepts a recovery code, and a recovery code does not expire.
    rm -f "${dir}/srcPassword" "${dir}/mfa" "${dir}/site-bundle.zip" \
          "${dir}/cookies-src" "${dir}/cookies-dst" "${dir}/.api-req" "${dir}/.api-out"
    if (( DB_CREATED == 1 )); then
      warn "removing the staging database this run created"
      "$CLPCTL" db:delete --databaseName="$STG_DB_NAME" --force >&2 2>/dev/null || true
    fi
    drop_template_stage
    drop_vhost_stage
    if [[ -n $TEMPLATE_NAME ]]; then
      "$CLPCTL" vhost-template:delete --name="$TEMPLATE_NAME" >&2 2>/dev/null || true
      TEMPLATE_NAME=""
    fi
    # Keyed on what was created rather than on one flag for both, because an
    # Instatic clone can have created the instance while adopting the site.
    if (( SITE_VIA_INSTATIC == 1 )); then
      # Through the Instatic wrapper, which also removes the container and
      # archives the data. Deleting the CloudPanel site directly would leave a
      # running container bound to a port nothing routes to -- and that wrapper
      # is also the side that knows whether the site was its to delete: it reads
      # siteCreatedByAddon out of the instance's own meta.json and leaves an
      # adopted site in place.
      warn "removing the staging Instatic instance this run created"
      "$INSTATIC_WRAPPER" delete --domain "$target" --confirm "$target" >&2 2>/dev/null || true
    elif (( SITE_CREATED == 1 )); then
      warn "removing the staging site this run created"
      "$CLPCTL" site:delete --domainName="$target" --force >&2 2>/dev/null || true
    fi
    if [[ $(job_get "$dir" state) != "failed" ]]; then
      job_set "$dir" error "clone failed during '${STEP}'"
      job_set "$dir" state failed
    fi
    return $rc
  }
  trap rollback EXIT

  # --- source facts ---------------------------------------------------------
  set_step "reading the source site"
  local -a notes=()
  local row src_type src_user src_root src_app php_version="" src_db=""
  row=$(site_row "$source") || fail_job "cannot read the panel database"
  [[ -n $row ]] || fail_job "no CloudPanel site for ${source}"
  IFS='|' read -r src_type src_user src_root src_app <<< "$row"
  type_is_clonable "$src_type" \
    || fail_job "${source} is a '${src_type}' site; only ${CLONABLE_TYPES[*]} sites can be cloned"
  [[ -n $src_user ]] || fail_job "${source} has no site user recorded"

  # Conditional, not unconditional: a static site has no php_settings row, and
  # demanding one is what used to abort the clone before it had started. Every
  # step below is likewise driven by what the source *has* -- a source with no
  # database simply skips the database steps -- rather than by its type.
  if [[ $src_type == "php" ]]; then
    php_version=$(php_version_of "$source")
    [[ -n $php_version ]] || fail_job "cannot determine the PHP version of ${source}"
  fi
  src_db=$(database_of "$source")

  # The panel records which named template a site was created from, so the
  # clone can be created from the same one instead of a guess. Older rows can
  # have no application; Generic is what the panel itself falls back to.
  #
  # A name that fails application_ok is discarded here rather than carried any
  # further, because from this point it would become a --vhostTemplate argument
  # and a value in the clone's own panel record. Discarded, not repaired: the
  # hostile string is thrown away whole and the stock name used instead, which
  # is a fallback rather than the sanitizing the rules here forbid. It costs a
  # label and a note; refusing the clone over the source's label would cost the
  # clone.
  if [[ -n $src_app ]] && ! application_ok "$src_app"; then
    notes+=("${source} records an application name this addon will not put in a query or a command line, so the clone was built from Generic instead; check Site -> Vhost on ${source}")
    warn "${source} has an unusable site.application; falling back to Generic"
    src_app=""
  fi
  [[ -n $src_app ]] || src_app="Generic"

  local src_dir="/home/${src_user}/htdocs/${source}"

  # --- an Instatic source, established and exported before anything exists ---
  # Both halves of this happen before the clone is created, and deliberately:
  # a backend that turns out not to be ours must be refused with nothing built,
  # and an export that fails must not leave a half-made staging site behind.
  local src_port="" src_tag="" export_zip="" src_password=""
  if [[ $src_type == "reverse-proxy" ]]; then
    instatic_backend_of "$source" || fail_job "${source} cannot be cloned: ${INSTATIC_REJECT}"
    src_port=$INSTATIC_PORT
    src_tag=$INSTATIC_TAG
    [[ -n $port ]]  || fail_job "no port was allocated for the clone's Instatic instance"
    [[ -n $email ]] || fail_job "cloning an Instatic site needs the source instance's admin email address"
    [[ -s "${dir}/srcPassword" ]] \
      || fail_job "cloning an Instatic site needs the source instance's admin password"
    # Read off disk rather than out of argv, and held only for the two requests
    # that need it. The setup of the source was run long ago, so this is the one
    # credential in a clone that the stager cannot mint for itself.
    src_password=$(cat "${dir}/srcPassword")

    set_step "signing in to ${source}"
    instatic_login "$src_port" "$source" "${dir}/cookies-src" \
      "$email" "$src_password" "$mfa" "$source" || fail_job "$INSTATIC_REJECT"
    # Both credentials have done their one job: everything after this rides in
    # the cookie jar. Deleted here rather than after the export, which is the
    # long step and needs neither of them -- and the authentication code
    # especially, because validate_mfa deliberately accepts a recovery code and a
    # recovery code does not expire. Nothing used to delete it at all, so it
    # outlived the clone by the fourteen days a job record is kept.
    src_password=""
    mfa=""
    rm -f "${dir}/srcPassword" "${dir}/mfa"

    set_step "exporting ${source}'s content"
    export_zip="${dir}/site-bundle.zip"
    local export_code
    export_code=$(instatic_get "$src_port" "$source" "${dir}/cookies-src" \
      "/admin/api/cms/export?includeSite=1&includeMedia=1" "$export_zip")
    if [[ ! $export_code =~ ^2 ]]; then
      fail_job "${source} refused the export (HTTP ${export_code}): $(instatic_error "$export_zip")"
    fi
    # The session goes rather than being left to expire: a clone should leave
    # nothing live on its source.
    instatic_logout "$src_port" "$source" "${dir}/cookies-src"
    log "exported $(stat -c%s "$export_zip") bytes of site bundle"
  else
    [[ -d $src_dir ]] || fail_job "source directory not found: ${src_dir}"
  fi

  # --- the source's own vhost, if it can be carried safely ------------------
  # Attempted for every clone rather than asked about, because the operator has
  # no way to know in advance whether their source has edits. When it cannot be
  # done the clone still gets built from the stock template and the job says
  # what was left behind, so the failure is a message rather than a missing
  # clone -- and never a staging site answering for production.
  #
  # Two routes, and the order matters. CloudPanel's own template mechanism is
  # preferred wherever it exists, because then the panel does every write; it
  # exists only for php, since site:add:php is the only site:add verb with a
  # --vhostTemplate option. Everything else, and any php source the template
  # route refuses, falls through to carry_vhost below.
  #
  # Resolved quietly here and only mentioned below if it ends up being used:
  # saying the base template is missing is noise when the source's own vhost
  # was carried across and the base was never reached.
  local base_template=$src_app base_missing=0 template_route=0 template_reject=""
  local vhost_template=$base_template
  if [[ $src_type == "php" ]]; then
    if ! vhost_template_exists "$base_template"; then
      base_missing=1
      base_template="Generic"
      vhost_template=$base_template
    fi
    if build_vhost_template "$source" "$target" \
       && vhost_template_ok "$TEMPLATE_FILE" "$source" "$target"; then
      local candidate="clp-stager-${id}"
      if "$CLPCTL" vhost-template:add --name="$candidate" --file="$TEMPLATE_FILE" >&2; then
        TEMPLATE_NAME=$candidate
        vhost_template=$candidate
        template_route=1
        log "carrying ${source}'s vhost across through CloudPanel's own template mechanism"
      else
        template_reject="CloudPanel would not accept a vhost template built from ${source}"
      fi
    else
      # No apostrophe in the default: bash runs quote processing over the word
      # of a ${x:-word}, so one there opens a single-quoted string that swallows
      # the rest of the file.
      template_reject="${VHOST_REJECT:-the stored vhost could not be read}"
    fi
    drop_template_stage
  fi

  local stg_user stg_pass
  stg_user=$(site_user_for "$target")
  user_taken "$stg_user" && fail_job "the site user ${stg_user} already exists; ${target} may be half-created"
  stg_pass=$(gen_password)

  case $src_type in
    php)
      set_step "creating the staging site ${target} on PHP ${php_version}"
      "$CLPCTL" site:add:php \
        --domainName="$target" \
        --phpVersion="$php_version" \
        --vhostTemplate="$vhost_template" \
        --siteUser="$stg_user" \
        --siteUserPassword="$stg_pass" >&2 \
        || fail_job "clpctl site:add:php failed for ${target}"
      SITE_CREATED=1 ;;
    static)
      set_step "creating the staging site ${target}"
      "$CLPCTL" site:add:static \
        --domainName="$target" \
        --siteUser="$stg_user" \
        --siteUserPassword="$stg_pass" >&2 \
        || fail_job "clpctl site:add:static failed for ${target}"
      SITE_CREATED=1 ;;
    reverse-proxy)
      # One call, and it makes the CloudPanel site, the container, the data
      # directory and a master key of the clone's own. Delegated rather than
      # reimplemented because that wrapper is where "what an Instatic instance
      # is" lives, and a second implementation of it here would drift.
      set_step "creating the staging Instatic instance ${target} on port ${port}"
      # stdout is captured rather than folded into the log, because the reply is
      # the only place the created-or-adopted answer exists for *this* call. The
      # wrapper's progress still goes to stderr and therefore into the job's
      # transcript.
      "$INSTATIC_WRAPPER" create --domain "$target" --port "$port" --tag "$src_tag" \
        > "${dir}/.instatic-create" \
        || fail_job "the Instatic addon could not create an instance for ${target}"
      # The container and the data directory are always this job's: that wrapper
      # refuses outright if either already exists, so a zero exit means it made
      # them. Unwinding therefore goes back through it whatever happened to the
      # site.
      SITE_VIA_INSTATIC=1
      # The site is a separate question, and it is the one that decides whether
      # the panel record may be rewritten. That wrapper adopts a matching
      # pre-existing reverse-proxy site rather than failing, and says so; taking
      # its exit status as "created" claimed a row this job did not make, which
      # is precisely what SITE_CREATED exists to refuse. Anything but an explicit
      # `true` counts as adopted, because the safe answer to "am I sure this is
      # mine" is no.
      if [[ $(json_field "${dir}/.instatic-create" siteCreatedByAddon) == "true" ]]; then
        SITE_CREATED=1
      else
        notes+=("the CloudPanel site for ${target} already existed and was adopted rather than created, so its vhost and panel record were left as they were")
      fi
      rm -f "${dir}/.instatic-create" ;;
  esac

  # Its whole purpose was this one site:add:php. CloudPanel copies the rendered
  # body into the site's own record, so the clone is unaffected by the template
  # going away, and the panel's template library does not grow by one entry per
  # clone. Only site.application still names it, which is put back below.
  if [[ -n $TEMPLATE_NAME ]]; then
    "$CLPCTL" vhost-template:delete --name="$TEMPLATE_NAME" >&2 \
      || warn "could not remove the temporary vhost template ${TEMPLATE_NAME}"
    TEMPLATE_NAME=""
  fi

  # Read back rather than re-derived. The account is whatever CloudPanel
  # actually recorded, which is the same thing every other part of this project
  # treats as the source of truth.
  local recorded_user
  recorded_user=$(panel_query "SELECT user FROM site WHERE domain_name = '$target';") || recorded_user=""
  if [[ -n $recorded_user ]]; then stg_user=$recorded_user; fi

  local dest_dir="/home/${stg_user}/htdocs/${target}"
  [[ -d $dest_dir ]] || fail_job "CloudPanel did not create ${dest_dir}"

  # --- the vhost, now that there is a clone to put one on -------------------
  local vhost_carried=0 vhost_by="stock" clone_application
  clone_application=$(application_of "$target") || clone_application=""
  # Read back off the clone's own row, which clpctl wrote seconds ago, so this
  # should always be a stock name -- but it is the value that goes back into the
  # row below, and a read-back is owed the same check as an argument.
  if [[ -n $clone_application ]] && ! application_ok "$clone_application"; then
    clone_application=""
  fi
  [[ -n $clone_application ]] || clone_application="Generic"
  if [[ $src_type == "php" ]]; then clone_application=$base_template; fi

  if (( template_route == 1 )); then
    vhost_carried=1
    vhost_by="template"
    # site.application is left naming a template the panel no longer has, which
    # is what the clone's Vhost tab then reports it was built from. One scoped
    # UPDATE puts the base name back; a failure here costs a label, so it is a
    # note rather than a failed clone.
    if [[ $(application_of "$target") != "$clone_application" ]]; then
      panel_update_site "$target" "$src_type" "$clone_application" \
        || notes+=("the clone's Vhost tab still names the temporary template this job used: ${PANEL_WRITE_REJECT}")
    fi
  else
    set_step "carrying ${source}'s vhost onto the clone"
    if carry_vhost "$source" "$target" "$src_type" "$clone_application"; then
      vhost_carried=1
      vhost_by="rendered"
      log "carried ${source}'s vhost across by writing the clone's panel record and rendering its file"
    else
      notes+=("${source}'s vhost was not carried across: ${CARRY_REJECT}. The clone keeps the stock ${clone_application} vhost; copy the edits across in Site -> Vhost")
      if [[ -n $template_reject ]]; then
        notes+=("CloudPanel's own template route was not taken either: ${template_reject}")
      fi
    fi
    drop_vhost_stage
  fi
  if (( base_missing == 1 )); then
    notes+=("${source} names a vhost template the panel no longer has, so ${base_template} was used instead")
  fi

  # --- the database ---------------------------------------------------------
  if [[ -n $src_db ]]; then
    STG_DB_NAME=$(db_name_for "$target")
    STG_DB_USER=$(db_user_for "$target")
    STG_DB_PASS=$(gen_db_password)

    # Into the job directory, which is 0700 root. The original script wrote it
    # to /tmp under a name derived from the production database, where any
    # local user could read a full dump of it, or pre-create the path as a
    # symlink and have root write through it.
    DUMP_FILE="${dir}/dump.sql.gz"

    set_step "exporting ${src_db}"
    "$CLPCTL" db:export --databaseName="$src_db" --file="$DUMP_FILE" >&2 \
      || fail_job "clpctl db:export failed for ${src_db}"
    chmod 600 "$DUMP_FILE"

    set_step "creating the staging database ${STG_DB_NAME}"
    "$CLPCTL" db:add \
      --domainName="$target" \
      --databaseName="$STG_DB_NAME" \
      --databaseUserName="$STG_DB_USER" \
      --databaseUserPassword="$STG_DB_PASS" >&2 \
      || fail_job "clpctl db:add failed for ${STG_DB_NAME}"
    DB_CREATED=1

    set_step "importing into ${STG_DB_NAME}"
    "$CLPCTL" db:import --databaseName="$STG_DB_NAME" --file="$DUMP_FILE" >&2 \
      || fail_job "clpctl db:import failed for ${STG_DB_NAME}"

    rm -f "$DUMP_FILE"
    DUMP_FILE=""
  else
    log "the source site has no database; skipping the database steps"
  fi

  # --- files ----------------------------------------------------------------
  # An Instatic site's document root is empty by construction -- it is a pure
  # reverse proxy -- and its content lives inside a container, so copying the
  # docroot would copy nothing and imply the content had moved. The bundle
  # below is what moves it.
  if [[ $src_type == "reverse-proxy" ]]; then
    log "the source is a reverse proxy; its content moves through the site bundle rather than through its document root"
  else
    set_step "copying files"
    # pipefail so a source-side failure is not masked by the receiving tar
    # reporting success. tar exit 1 is "file changed as we read it", which is
    # normal on a live site; 2 and above are real.
    local rc=0
    set +e
    ( set -o pipefail; tar -C "$src_dir" -cf - . | tar -xf - -C "$dest_dir" )
    rc=$?
    set -e
    (( rc >= 2 )) && fail_job "copying files failed (tar exit ${rc})"
    chown -R "${stg_user}:${stg_user}" "$dest_dir" || fail_job "could not chown ${dest_dir}"
  fi

  # --- the clone's own Instatic content --------------------------------------
  local inst_email="" inst_pass=""
  if [[ $src_type == "reverse-proxy" ]]; then
    inst_email="admin@${target}"
    inst_pass=$(gen_password)

    set_step "bootstrapping the clone's Instatic owner"
    instatic_setup "$port" "$target" "${dir}/cookies-dst" "$inst_email" "$inst_pass" "$target" \
      || fail_job "$INSTATIC_REJECT"

    set_step "signing in to the clone"
    instatic_login "$port" "$target" "${dir}/cookies-dst" "$inst_email" "$inst_pass" "" "the clone" \
      || fail_job "$INSTATIC_REJECT"
    instatic_step_up "$port" "$target" "${dir}/cookies-dst" "$inst_pass" "" \
      || fail_job "$INSTATIC_REJECT"

    set_step "importing ${source}'s content into the clone"
    # strategy=replace rather than a merge: setup seeds a starter homepage, and
    # merging would leave it beside the imported pages. The clone should match
    # its source rather than merely contain it.
    local import_code
    import_code=$(instatic_post "$port" "$target" "${dir}/cookies-dst" \
      "/admin/api/cms/import/archive?strategy=replace" "application/zip" \
      "$export_zip" "${dir}/.api-out")
    if [[ ! $import_code =~ ^2 ]]; then
      fail_job "the clone refused the import (HTTP ${import_code}): $(instatic_error "${dir}/.api-out")"
    fi
    log "import: $(instatic_error "${dir}/.api-out")"
    rm -f "${dir}/.api-out"
    instatic_logout "$port" "$target" "${dir}/cookies-dst"
    rm -f "$export_zip"
    export_zip=""

    notes+=("the clone's PUBLIC_ORIGIN is https://${target}, but absolute links typed into a page still name ${source}; the bundle carries content, not a URL rewrite")
    notes+=("integration secrets such as API keys and TOTP seeds are encrypted under ${source}'s own key and are deliberately absent from the bundle; re-enter them on the clone")
  fi

  # --- application config ---------------------------------------------------
  if [[ -n $src_db ]]; then
    set_step "rewriting the application's database credentials"
    if [[ -f "${dest_dir}/wp-config.php" ]]; then
      rewrite_wp_config "${dest_dir}/wp-config.php" "$target"
      if command -v wp >/dev/null 2>&1; then
        set_step "rewriting URLs with wp-cli"
        run_wp_search_replace "$stg_user" "$dest_dir" "$source" "$target" \
          || notes+=("wp-cli search-replace reported problems; check the log")
      else
        notes+=("wp-cli is not installed, so URLs inside the database still name ${source}")
      fi
    elif [[ -f "${dest_dir}/.env" ]]; then
      rewrite_dotenv "${dest_dir}/.env"
    else
      notes+=("no wp-config.php or .env found, so the database credentials were not written into the application; they are in this job's result")
    fi
  fi

  # --- what the clone could not carry over ----------------------------------
  local stg_root
  stg_root=$(panel_query "SELECT root_directory FROM site WHERE domain_name = '$target';")
  if [[ -n $src_root && -n $stg_root && "${src_root#"$source"}" != "${stg_root#"$target"}" ]]; then
    notes+=("the source's root directory is '${src_root}' but the clone's is '${stg_root}'; set it in Site -> Settings")
  fi
  # Only when the carry-over was attempted and appeared to work. If it was
  # refused, the note saying so was added above and already names the reason;
  # repeating it in different words reads like two separate problems.
  if (( vhost_carried == 1 )) && vhost_differs "$source" "$target" "$src_user" "$stg_user"; then
    notes+=("${source}'s vhost still differs from the clone's after carrying it across. Compare them in Site -> Vhost")
  fi

  # --- certificate ----------------------------------------------------------
  if [[ $tls == "yes" ]]; then
    set_step "requesting a Let's Encrypt certificate for ${target}"
    if ! "$CLPCTL" lets-encrypt:install:certificate --domainName="$target" >&2; then
      notes+=("the certificate request failed; point ${target} at this server and retry from Site -> SSL/TLS")
    fi
  else
    notes+=("no certificate was requested; ${target} is served with CloudPanel's self-signed one until you issue one")
  fi

  # --- result ---------------------------------------------------------------
  # Named for what is happening rather than "done": the state file is what says
  # the clone finished, and a step that claims it a moment early is the kind of
  # thing an operator reads as a hang when the next line takes a while.
  set_step "recording the result"
  local notes_json="["
  local first=1 n
  for n in ${notes[@]+"${notes[@]}"}; do
    (( first == 1 )) || notes_json+=","
    notes_json+=$(json_str "$n")
    first=0
  done
  notes_json+="]"

  local db_json="null"
  if [[ -n $src_db ]]; then
    db_json=$(printf '{"source":%s,"name":%s,"user":%s,"password":%s}' \
      "$(json_str "$src_db")" "$(json_str "$STG_DB_NAME")" \
      "$(json_str "$STG_DB_USER")" "$(json_str "$STG_DB_PASS")")
  fi

  # The clone's Instatic owner gets the same treatment as the staging database
  # password, and for the same reason: it is minted here, it is the only way
  # into the clone's admin, and nothing else can show it again.
  local instatic_json="null"
  if [[ $src_type == "reverse-proxy" ]]; then
    instatic_json=$(printf '{"port":%d,"tag":%s,"email":%s,"password":%s}' \
      "$port" "$(json_str "$src_tag")" "$(json_str "$inst_email")" "$(json_str "$inst_pass")")
  fi

  # The database password is the one credential here that cannot be read back
  # out of the panel, and it is needed whenever the application's config could
  # not be rewritten. 0600 in a 0700 directory, and `prune` drops the whole
  # record after JOB_RETENTION_DAYS.
  printf '{"siteType":%s,"siteUser":%s,"phpVersion":%s,"vhostTemplate":%s,"vhostCarried":%s,"vhostCarriedBy":%s,"database":%s,"instatic":%s,"notes":%s}\n' \
    "$(json_str "$src_type")" "$(json_str "$stg_user")" "$(json_str "$php_version")" \
    "$(json_str "$clone_application")" \
    "$( (( vhost_carried == 1 )) && echo true || echo false )" \
    "$(json_str "$vhost_by")" \
    "$db_json" "$instatic_json" "$notes_json" > "${dir}/result.json"
  chmod 600 "${dir}/result.json"

  job_set "$dir" finishedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  job_set "$dir" state "done"
  trap - EXIT
  log "clone complete: ${target}"
}

# sed rather than a PHP parser, on the four defines CloudPanel's own templates
# and every WordPress install agree on. Every replacement value is generated by
# this script from [A-Za-z0-9], so none of them can carry a sed metacharacter.
rewrite_wp_config() {
  local file=$1 target=$2
  sed -i \
    -e "s/define( *'DB_NAME', *'[^']*' *);/define('DB_NAME', '${STG_DB_NAME}');/g" \
    -e "s/define( *'DB_USER', *'[^']*' *);/define('DB_USER', '${STG_DB_USER}');/g" \
    -e "s/define( *'DB_PASSWORD', *'[^']*' *);/define('DB_PASSWORD', '${STG_DB_PASS}');/g" \
    "$file"

  if grep -q "WP_HOME" "$file"; then
    sed -i \
      -e "s|define( *'WP_HOME', *'[^']*' *);|define('WP_HOME', 'https://${target}');|g" \
      -e "s|define( *'WP_SITEURL', *'[^']*' *);|define('WP_SITEURL', 'https://${target}');|g" \
      "$file"
  else
    sed -i "/define( *'DB_PASSWORD'/a define('WP_HOME', 'https://${target}');\ndefine('WP_SITEURL', 'https://${target}');" "$file"
  fi

  if grep -q "DOMAIN_CURRENT_SITE" "$file"; then
    sed -i "s/define( *'DOMAIN_CURRENT_SITE', *'[^']*' *);/define('DOMAIN_CURRENT_SITE', '${target}');/g" "$file"
  fi
}

rewrite_dotenv() {
  local file=$1
  sed -i \
    -e "s/^DB_DATABASE=.*/DB_DATABASE=${STG_DB_NAME}/" \
    -e "s/^DB_USERNAME=.*/DB_USERNAME=${STG_DB_USER}/" \
    -e "s/^DB_PASSWORD=.*/DB_PASSWORD=${STG_DB_PASS}/" \
    "$file"
}

# As the staging site's own user, never as root: wp-cli refuses to run as root
# without --allow-root, and running a site's plugins as root is exactly the
# thing that flag exists to stop.
run_wp_search_replace() {
  local user=$1 path=$2 from=$3 to=$4
  local -a cmd=(runuser -u "$user" -- env "HOME=/home/${user}" wp
                --path="$path" --skip-plugins --skip-themes search-replace)
  if grep -q "DOMAIN_CURRENT_SITE" "${path}/wp-config.php" 2>/dev/null; then
    "${cmd[@]}" "$from" "$to" --network >&2
  else
    "${cmd[@]}" "https://${from}" "https://${to}" >&2
  fi
}

# Normalise a stored vhost body down to what an operator actually chose.
#
# `site.vhost_template` is not a rendered config: it keeps CloudPanel's own
# {{ssl_certificate}}, {{root}}, {{php_fpm_port}} and the rest, and only the
# hostnames are concrete. Two things in it are generated per site rather than
# chosen, and comparing without accounting for them reports an edit on every
# ordinary clone:
#
#   - CloudPanel prepends an http->https redirect server block, but only when
#     the hostname is an apex or www. Cloning example.com to stg.example.com
#     means the source has that block and the clone does not.
#   - ServerNameProcessor writes `server_name <domain> www1.<domain>;` for an
#     apex and `server_name <domain>;` for a subdomain.
#
# Both are folded away here. Anything else in a server_name line survives, so a
# hand-widened `server_name <domain> *.<domain>;` still reads as an edit, which
# is the case this check exists for.
# An ERE matching $1 only as a whole hostname, capturing the characters either
# side so a substitution can put them back.
#
# A hostname is not a substring: example.com appears inside stg.example.com and
# inside notexample.com, and treating it as one either rewrites hostnames that
# merely end in it or reports the clone's own name as the source leaking
# through. The neighbouring character must not be one that can continue a
# hostname, which for the left side includes the dot.
hostname_boundary() {
  local h=${1//./\\.}
  printf '(^|[^A-Za-z0-9.-])%s([^A-Za-z0-9-]|$)' "$h"
}

# Drop the http->https redirect server block CloudPanel prepends. It is present
# only when the hostname is an apex or www, so a source and its subdomain clone
# differ by the whole block without anyone having edited anything.
strip_redirect_block() {
  awk '
    NR == 1 && /^server \{/ { block = $0 ORS; depth = 1; inblock = 1; next }
    inblock {
      block = block $0 ORS
      depth += gsub(/\{/, "{") - gsub(/\}/, "}")
      if (/return 301/) redirect = 1
      if (depth == 0) { inblock = 0; if (!redirect) printf "%s", block }
      next
    }
    { print }
  '
}

# Replace the two forms ServerNameProcessor generates with $2, leaving any other
# server_name line alone. A hand-widened `server_name <d> *.<d>;` is not one of
# them and survives, which is what lets both callers below tell an edit from a
# rendering artefact.
fold_server_name() {
  local domain=${1//./\\.} repl=$2
  sed -e "s|^\([[:space:]]*\)server_name ${domain} www1\\.${domain};[[:space:]]*\$|\\1${repl}|" \
      -e "s|^\([[:space:]]*\)server_name ${domain};[[:space:]]*\$|\\1${repl}|"
}

# The inverse of strip_redirect_block: emit only the block it drops.
#
# The redirect is generated from the hostname, so a clone gets whichever block
# its own name earns rather than the source's. Composing a body means dropping
# the source's and prepending the target's, and the two halves are written as
# each other's mirror so a change to what counts as the redirect block cannot
# be made in one of them alone.
take_redirect_block() {
  awk '
    NR == 1 && /^server \{/ { block = $0 ORS; depth = 1; inblock = 1; next }
    inblock {
      block = block $0 ORS
      depth += gsub(/\{/, "{") - gsub(/\}/, "}")
      if (/return 301/) redirect = 1
      if (depth == 0) { if (redirect) printf "%s", block; exit }
      next
    }
  '
}

# The server_name line CloudPanel generated for this site, lifted out of its own
# stored body rather than rebuilt from the domain.
#
# ServerNameProcessor writes two forms and picks between them by whether the
# hostname is an apex, which is a rule this file would otherwise have to keep a
# second copy of. Reading back what the panel actually wrote a moment ago is
# what keeps the clone's line right across a panel that changes its mind.
generated_server_name() {
  local d=$1
  awk -v d="$d" '
    {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (line == "server_name " d ";" || line == "server_name " d " www1." d ";") {
        print line
        exit
      }
    }
  '
}

vhost_shape() {
  local body=$1 domain=$2
  printf '%s\n' "$body" \
    | strip_redirect_block \
    | fold_server_name "$domain" "server_name {GENERATED};" \
    | grep -v '^[[:space:]]*$'
}

# True when the source's vhost holds edits the clone will not have.
#
# Both bodies come out of the panel's own record, so this compares what the
# panel will render rather than what happens to be on disk.
vhost_differs() {
  local source=$1 target=$2 src_user=$3 stg_user=$4
  local a b
  a=$(vhost_of "$source") || return 1
  b=$(vhost_of "$target") || return 1
  [[ -n $a && -n $b ]] || return 1
  a=$(vhost_shape "$a" "$source")
  b=$(vhost_shape "$b" "$target")
  a=${a//"$source"/"$target"}
  a=${a//"$src_user"/"$stg_user"}
  [[ $a != "$b" ]]
}

# Build a named vhost template that reproduces the source's config for the
# clone, or fail.
#
# The clone is created from this instead of the stock template, which is what
# carries the source's hand edits across. Going through CloudPanel's own
# template mechanism rather than writing the vhost ourselves matters twice
# over: the panel renders every {{placeholder}} against the *clone's* values,
# so the copy tracks its own certificate, root, php-fpm port and log paths
# rather than freezing the source's; and the panel writes both its database
# record and the file on disk, so nothing it does later reverts the result. A
# vhost written only to disk is reverted by the next thing that regenerates it.
# Where a candidate template is handed to clpctl, and why it is not the job
# directory.
#
# /usr/bin/clpctlWrapper ends with `su -s /bin/bash -c "$COMMAND" clp`, so
# clpctl reads --file as the clp user rather than as root. A job directory is
# 0700 root, so the panel saw an unreadable path as an empty template and
# refused it with "Vhost Template cannot be empty". The handoff is root:clp
# 0640 inside a 0710 root:clp directory: exactly one other account can read it
# and none can list the directory. Removed as soon as the template is
# registered, and by the rollback if it is not.
TEMPLATE_STAGE=""
TEMPLATE_FILE=""

# One staging directory, made the same way for both accounts that have to reach
# into it: clpctl reading a --file, and sqlite3 reading a body through
# readfile() while running as clp. Written once so the two cannot drift into
# different modes, which is the kind of difference that shows up as an empty
# template rather than as an error.
make_clp_stage() {
  local dir
  dir=$(mktemp -d /tmp/clp-stager-stage.XXXXXXXX) || return 1
  chown root:clp "$dir" && chmod 710 "$dir" || return 1
  printf '%s' "$dir"
}

# The text transform, on stdout. Separate from the staging below because it is
# the part with the rules in it, and keeping it free of root and of the clp
# group is what lets tools/test-app.ts drive it on any machine. It used to be
# one function, and the test that covered it therefore needed both -- which
# passed here and failed in CI.
vhost_template_body() {
  local source=$1 target=$2 body cand

  body=$(vhost_of "$source") || return 1
  [[ -n $body ]] || return 1

  cand=$(printf '%s\n' "$body" | strip_redirect_block | fold_server_name "$source" "{{server_name}}")
  # Whatever names the source after the generated forms are folded away is a
  # hand edit that mentions the hostname, and it has to name the clone instead.
  #
  # Not a plain substring replacement. The ordinary target is a subdomain of the
  # source -- stg.example.com contains example.com -- so replacing the substring
  # rewrites hostnames that merely end in it, and testing for the substring
  # afterwards flags the clone's own name as a leak. Both are done on whole
  # hostname boundaries instead.
  cand=$(printf '%s\n' "$cand" | sed -E "s/$(hostname_boundary "$source")/\\1${target}\\2/g")
  [[ -n $cand ]] || return 1

  printf '%s\n' "$cand"
}

build_vhost_template() {
  local source=$1 target=$2 cand
  TEMPLATE_FILE=""

  cand=$(vhost_template_body "$source" "$target") || return 1
  [[ -n $cand ]] || return 1

  TEMPLATE_STAGE=$(make_clp_stage) || return 1
  TEMPLATE_FILE="${TEMPLATE_STAGE}/vhost.tpl"
  printf '%s\n' "$cand" > "$TEMPLATE_FILE"
  chown root:clp "$TEMPLATE_FILE" && chmod 640 "$TEMPLATE_FILE" || return 1
}

drop_template_stage() {
  [[ -n $TEMPLATE_STAGE ]] || return 0
  rm -rf "$TEMPLATE_STAGE"
  TEMPLATE_STAGE=""
  TEMPLATE_FILE=""
  return 0
}

# Is this a named template the panel still has?
#
# site.application records the name a site was created from, not a reference to
# it, so the template can have been deleted or renamed since. Falling back to
# one that is gone fails site:add:php with "Vhost Template ... does not exist",
# which is a confusing way to lose a clone.
#
# A name that fails application_ok answers "no" rather than being escaped into
# the query. This used to double the quotes in it, which is sanitizing the one
# kind of input the rules here say to reject -- and it put a caller-influenced
# string in a statement run by `sqlite3 -readonly`, where `writefile()` is still
# compiled in. Fail-closed is also the right answer on its own terms: a template
# whose name this addon will not query is one it must not create a site from.
vhost_template_exists() {
  local n
  application_ok "$1" || return 1
  n=$(panel_query "SELECT COUNT(*) FROM vhost_template WHERE name = '${1}';") || return 1
  [[ ${n:-0} -gt 0 ]]
}

# Set when the template is refused, so the job can say why rather than leaving
# an operator to guess which of several conditions applied.
VHOST_REJECT=""

# Would this template give the clone a config that is safe to serve?
#
# The dangerous outcome is a clone that answers for the site it was cloned from:
# two nginx server blocks claiming one server_name, on a box where the other one
# is production. CloudPanel's own validator catches part of it -- it requires
# {{server_name}} and rejects a template without one -- but only part, so the
# checks it does not make are made here, before it is asked.
vhost_template_ok() {
  local file=$1 source=$2 target=$3
  VHOST_REJECT=""

  if ! grep -q '{{server_name}}' "$file"; then
    VHOST_REJECT="the source's server_name is hand edited, so CloudPanel's {{server_name}} placeholder cannot be kept"
    return 1
  fi
  vhost_body_ok "$file" "$source" "$target"
}

# The two checks that are about safety rather than about clpctl's own validator.
#
# Split out of vhost_template_ok because the fallback below does not go through
# `vhost-template:add` and therefore owes nothing to its {{server_name}}
# requirement -- which means the fallback can carry a vhost whose server_name
# line is itself the hand edit, the one case the template route has to refuse.
# What it may not do is let the clone answer for the site it was cloned from,
# and that is exactly these two lines of reasoning: the source hostname must not
# survive anywhere, and every server_name token must be the target or below it.
vhost_body_ok() {
  local file=$1 source=$2 target=$3
  VHOST_REJECT=""

  # -i because DNS is case-insensitive. Without it `server_name RENAISSANCE.BG;`
  # walked straight past this check, and the clone answered for the production
  # apex it names.
  local leaks
  leaks=$(grep -ciE "$(hostname_boundary "$source")" "$file") || leaks=0
  if (( leaks > 0 )); then
    VHOST_REJECT="the source hostname still appears on ${leaks} line(s) after substitution"
    return 1
  fi

  # Collected into a variable rather than read from a process substitution,
  # because a substitution that fails to run at all leaves the loop with nothing
  # to iterate and this function returning 0 -- a gate that answers "safe"
  # because it could not look. This way the failure is a refusal.
  local hosts
  if ! hosts=$(server_name_hosts < "$file"); then
    VHOST_REJECT="the server_name directives in the composed vhost could not be read"
    return 1
  fi

  local tok host t=${target,,}
  while IFS= read -r tok; do
    [[ -n $tok ]] || continue
    # A wildcard is judged as the thing it covers: `*.example.com` is every
    # subdomain of example.com, so it has to clear the same bar example.com
    # would. `*.<target>` is the one wildcard form that passes, and it is a real
    # hand edit on this box.
    host=${tok#\*.}
    if [[ $host != "$t" && $host != *".${t}" ]]; then
      VHOST_REJECT="a server_name names '${tok}', which is not ${target} or below it"
      return 1
    fi
  done <<< "$hosts"

  return 0
}

# Every hostname a server_name directive in this config names, lowercased, one
# per line.
#
# Selecting the lines is what the first version got wrong, and it got it wrong
# in the direction that matters. It used
# `grep -E '^[[:space:]]*server_name '`, which demands a literal space and a
# line start, so the token check above never saw four real shapes. Driven end to
# end through compose_vhost_body and vhost_body_ok for a clone of
# renaissance.bg into stg.renaissance.bg, all four were ACCEPTED:
#
#   server_name<TAB>RENAISSANCE.BG;         claims the production apex
#   server_name<TAB>*.renaissance.bg;       claims every subdomain of it
#   server_name stg.renaissance.bg          a list whose second line is hostile
#                 victim-production.com;
#   listen 8443; server_name victim.com;    sharing a line with another directive
#
# Nothing downstream would have caught them. `nginx -t` treats a duplicate
# server_name as a *warning* and exits 0 -- measured -- and `sites-enabled/*.conf`
# glob order decides which block wins, so `dev.renaissance.bg.conf` sorts before
# `renaissance.bg.conf` and takes production's traffic. This gate is the only
# thing between a hand-edited source vhost and a clone that answers for
# production, because this path deliberately dropped the {{server_name}}
# requirement that used to make the outcome structurally unreachable.
#
# So the config is tokenised the way nginx reads one rather than matched as
# lines: arguments are separated by any whitespace including a newline, `;` ends
# a directive and needs no space around it, and a block brace can never sit
# inside a directive's arguments. Everything ambiguous yields a token that is not
# the target, and therefore a refusal -- `server_name _;` and a regex
# `server_name ~^.+$;` both land there, which is right, since either would have
# the clone answer for hostnames nobody chose.
server_name_hosts() {
  awk '
    {
      line = $0
      # A comment ends what nginx was reading, so a commented-out server_name is
      # not one nginx acts on. Only where # starts a token, so a # inside a
      # quoted value cannot swallow the rest of the line -- that direction would
      # hide a real directive rather than flag a dead one.
      sub(/(^|[[:space:]])#.*$/, "", line)
      gsub(/[;{}]/, " & ", line)
      n = split(line, t, /[[:space:]]+/)
      for (i = 1; i <= n; i++) {
        if (t[i] == "") continue
        if (t[i] == ";" || t[i] == "{" || t[i] == "}") { naming = 0; continue }
        if (naming) { print tolower(t[i]); continue }
        if (t[i] == "server_name") naming = 1
      }
    }
  '
}

# --- carrying a vhost without clpctl ----------------------------------------
#
# Everything from here is the fallback for the site types `site:add:*` gives no
# --vhostTemplate option. It runs after the clone already exists on its stock
# template, so the panel has just written a consistent
# (site.vhost_template, /etc/nginx/sites-enabled/<clone>.conf) pair -- and that
# pair, not a hardcoded list of processors, is what this reads the panel's
# substitutions out of.

# What this panel put into this site's vhost, learned by comparing the two
# halves of that pair.
#
# CloudPanel's renderer is pure {{placeholder}} substitution: Template::build()
# runs each placeholder's processor over the stored body and
# removeEmptyPlaceholders() blanks whatever is left. So splitting the stored
# body on its placeholders and walking the rendered file, matching each literal
# segment in order, recovers every value the panel produced. Doing it this way
# rather than reimplementing the processors is what keeps the addon correct
# across CloudPanel versions: it copies whatever *this* panel did to *this* site
# a moment ago.
#
# It fails closed in four ways, because a wrong value here is a wrong nginx
# config. The walk must consume the rendered file exactly to EOF; a placeholder
# appearing twice must resolve identically both times; two placeholders with
# nothing between them are refused rather than split at an arbitrary point; and
# the whole parse is done twice from opposite ends and the two must agree.
#
# That last one is not belt and braces, it is the guard the other three cannot
# be. Reading forwards, a value is the *shortest* string that reaches the next
# literal, so a wrong guess normally surfaces as a later literal failing to
# match. It does not when the literal separating two DIFFERENT placeholders also
# occurs inside the first one's value, because then the short guess and the long
# one both consume the file to EOF. Confirmed against the real function:
#
#   stored:   server {\n  {{settings}}\n  {{root}}\n}
#   rendered: server {\n  include /etc/nginx/a;\n  include /etc/nginx/b;
#             \n  root /home/u/htdocs/d;\n}
#
# was ACCEPTED, with settings="include /etc/nginx/a;" and root spanning the
# other two lines. The truth is settings="include a;\n  include b;", and
# rendering the *source's* body -- which differs from the stock one, the whole
# reason this exists -- would then have relocated or dropped a directive. No
# stock CloudPanel template on this box triggers it, but the layout that does is
# one they already use: a multi-line placeholder directly above another at the
# same indent, which is exactly {{nginx_access_log}} over {{nginx_error_log}}.
#
# Reading backwards takes the *longest* value instead. Where the parse is unique
# the two readings are the same map; where a boundary could sit in more than one
# place they differ, and differing is a refusal.
declare -A VHOST_MAP=()
VHOST_MAP_REJECT=""

learn_vhost_map() {
  local stored=$1 rendered=$2
  VHOST_MAP=()
  VHOST_MAP_REJECT=""

  local tpl out
  # The trailing `x` survives command substitution's newline strip, so a body
  # and a file that differ only in their final newline are not quietly made
  # equal -- which would leave the walk one byte short of EOF and refuse.
  tpl=$(cat "$stored"; printf x) || { VHOST_MAP_REJECT="the clone's stored vhost could not be read"; return 1; }
  out=$(cat "$rendered"; printf x) || { VHOST_MAP_REJECT="the clone's rendered vhost could not be read"; return 1; }
  tpl=${tpl%x}
  out=${out%x}
  # The panel writes the rendered template followed by one newline the template
  # itself does not carry -- measured on every site on this box, static, php and
  # reverse-proxy alike. Accounting for it here is what lets the walk below
  # demand EOF exactly rather than "near enough", and the installer stores the
  # body without one for the same reason.
  out=${out%$'\n'}

  # Split the stored body into literal and placeholder segments once, so the two
  # walks below are the same parse read in opposite directions rather than two
  # parsers that could disagree about something other than a boundary.
  local -a lits=() keys=()
  local rest=$tpl raw key
  while [[ $rest == *"{{"* ]]; do
    lits+=("${rest%%"{{"*}")
    rest=${rest#*"{{"}
    if [[ $rest != *"}}"* ]]; then
      VHOST_MAP_REJECT="the clone's stored vhost has an unterminated placeholder"
      return 1
    fi
    raw=${rest%%"}}"*}
    rest=${rest#*"}}"}
    # Template::getPlaceholders() matches /{{[\sa-zA-Z0-9_]+}}/, so whitespace
    # inside the braces is legal and names the same placeholder.
    key=${raw//[[:space:]]/}
    if [[ ! $key =~ ^[a-zA-Z0-9_]+$ ]]; then
      VHOST_MAP_REJECT="the clone's stored vhost has a placeholder named '${raw}'"
      return 1
    fi
    keys+=("$key")
  done
  lits+=("$rest")

  local n=${#keys[@]}
  (( n > 0 )) || return 0

  local i
  for (( i = 1; i < n; i++ )); do
    if [[ -z ${lits[i]} ]]; then
      VHOST_MAP_REJECT="the clone's stored vhost puts {{${keys[i-1]}}} and {{${keys[i]}}} next to each other, which cannot be read apart"
      return 1
    fi
  done

  # Forwards: every value is the shortest string that reaches the next literal.
  local -A fwd=()
  local o=$out tail value
  for (( i = 0; i < n; i++ )); do
    if [[ ${o:0:${#lits[i]}} != "${lits[i]}" ]]; then
      VHOST_MAP_REJECT="the rendered vhost diverges from the stored one before {{${keys[i]}}}"
      return 1
    fi
    o=${o:${#lits[i]}}
    if (( i + 1 < n )); then
      tail=${lits[i+1]}
      if [[ $o != *"$tail"* ]]; then
        VHOST_MAP_REJECT="the rendered vhost has nothing matching the text after {{${keys[i]}}}"
        return 1
      fi
      value=${o%%"$tail"*}
    else
      # The last placeholder is anchored at the end rather than at the next
      # literal, which is what makes "consumed exactly to EOF" a property of the
      # walk instead of a hope. It is also the multi-line case: {{php_settings}}
      # is the final placeholder and expands to nine lines.
      tail=${lits[n]}
      if [[ -n $tail && $o != *"$tail" ]]; then
        VHOST_MAP_REJECT="the rendered vhost does not end with the text after {{${keys[i]}}}"
        return 1
      fi
      value=${o%"$tail"}
    fi
    o=${o:${#value}}
    if [[ -v "fwd[${keys[i]}]" && ${fwd[${keys[i]}]} != "$value" ]]; then
      VHOST_MAP_REJECT="{{${keys[i]}}} was rendered two different ways in one vhost"
      return 1
    fi
    fwd[${keys[i]}]=$value
  done
  if [[ $o != "${lits[n]}" ]]; then
    VHOST_MAP_REJECT="the rendered vhost does not end where the stored one does"
    return 1
  fi

  # Backwards: every value is the longest string that still leaves the literal
  # before it somewhere to match.
  local -A bwd=()
  local p=$out
  if [[ -n ${lits[n]} ]]; then
    p=${p%"${lits[n]}"}
  fi
  for (( i = n - 1; i >= 0; i-- )); do
    if [[ -z ${lits[i]} ]]; then
      # Only reachable at i == 0: a body that opens with a placeholder has
      # nothing before it, so whatever is left is its value.
      value=$p
      p=""
    else
      if [[ $p != *"${lits[i]}"* ]]; then
        VHOST_MAP_REJECT="the rendered vhost has nothing matching the text before {{${keys[i]}}}"
        return 1
      fi
      value=${p##*"${lits[i]}"}
      p=${p%"${lits[i]}${value}"}
    fi
    if [[ -v "bwd[${keys[i]}]" && ${bwd[${keys[i]}]} != "$value" ]]; then
      VHOST_MAP_REJECT="{{${keys[i]}}} was rendered two different ways in one vhost"
      return 1
    fi
    bwd[${keys[i]}]=$value
  done
  if [[ -n $p ]]; then
    VHOST_MAP_REJECT="the rendered vhost does not begin where the stored one does"
    return 1
  fi

  for key in "${!fwd[@]}"; do
    if [[ ${bwd[$key]-} != "${fwd[$key]}" ]]; then
      VHOST_MAP_REJECT="{{${key}}} could be read out of the clone's vhost in more than one way, so where it ends is a guess"
      return 1
    fi
    VHOST_MAP[$key]=${fwd[$key]}
  done
  return 0
}

# Substitute the learned map through a composed body, on stdout.
#
# A placeholder the map does not know is a refusal, never an empty string. The
# panel's own removeEmptyPlaceholders() blanks the leftovers, and copying that
# behaviour here would silently drop a directive the source depends on -- an
# unknown {{root}} would produce a server block with no document root, which
# nginx accepts and serves as the wrong thing.
render_vhost_body() {
  local body=$1 out="" lit raw key
  VHOST_MAP_REJECT=""

  while [[ $body == *"{{"* ]]; do
    lit=${body%%"{{"*}
    body=${body#*"{{"}
    if [[ $body != *"}}"* ]]; then
      VHOST_MAP_REJECT="the composed vhost has an unterminated placeholder"
      return 1
    fi
    raw=${body%%"}}"*}
    body=${body#*"}}"}
    key=${raw//[[:space:]]/}
    if [[ ! $key =~ ^[a-zA-Z0-9_]+$ ]]; then
      VHOST_MAP_REJECT="the composed vhost has a placeholder named '${raw}'"
      return 1
    fi
    if [[ ! -v "VHOST_MAP[$key]" ]]; then
      VHOST_MAP_REJECT="the source's vhost uses {{${key}}}, which CloudPanel did not put in the clone's own"
      return 1
    fi
    out+="${lit}${VHOST_MAP[$key]}"
  done

  printf '%s' "${out}${body}"
}

# Set when composition is refused, so the job can name the reason.
VHOST_COMPOSE_REJECT=""

# The source's stored body, made into the clone's, on stdout.
#
# Four steps, and each one is undoing something CloudPanel generated rather than
# something an operator chose:
#
#   1. drop the source's http->https redirect block, which exists only because
#      the source's hostname is an apex or www;
#   2. put the target's own generated server_name line where the source's was,
#      taken from what the panel wrote for the clone a moment ago;
#   3. rewrite whatever still names the source -- a hand edit that mentions the
#      hostname -- on whole hostname boundaries, because example.com sits inside
#      both stg.example.com and notexample.com;
#   4. prepend the clone's own redirect block, if its own name earned one.
#
# Everything else in the source's body, including its placeholders, survives
# untouched: the point is that the clone's certificate, root, log paths and
# proxied port go on tracking the clone.
compose_vhost_body() {
  local source=$1 target=$2 src_body tgt_body name_line redirect cand
  VHOST_COMPOSE_REJECT=""

  src_body=$(vhost_of "$source") || { VHOST_COMPOSE_REJECT="the source's vhost could not be read"; return 1; }
  tgt_body=$(vhost_of "$target") || { VHOST_COMPOSE_REJECT="the clone's vhost could not be read"; return 1; }
  if [[ -z $src_body || -z $tgt_body ]]; then
    VHOST_COMPOSE_REJECT="the panel has no stored vhost for one of the two sites"
    return 1
  fi

  name_line=$(printf '%s\n' "$tgt_body" | generated_server_name "$target")
  if [[ -z $name_line ]]; then
    VHOST_COMPOSE_REJECT="the clone's own vhost has no generated server_name line to copy"
    return 1
  fi

  cand=$(printf '%s\n' "$src_body" | strip_redirect_block | fold_server_name "$source" "$name_line")
  cand=$(printf '%s\n' "$cand" | sed -E "s/$(hostname_boundary "$source")/\\1${target}\\2/g")
  # Dropping the redirect block leaves the blank line that separated it from the
  # next one, so the body would start with an empty line the panel never writes.
  # Cosmetic in nginx, visible in the Vhost tab, and it would make a clone's body
  # differ from its own stock one by a byte nobody chose.
  cand=$(printf '%s\n' "$cand" | sed '/./,$!d')
  if [[ -z $cand ]]; then
    VHOST_COMPOSE_REJECT="the source's vhost was empty once its generated parts were removed"
    return 1
  fi

  redirect=$(printf '%s\n' "$tgt_body" | take_redirect_block)
  if [[ -n $redirect ]]; then
    printf '%s\n\n%s\n' "$redirect" "$cand"
  else
    printf '%s\n' "$cand"
  fi
}

# The one write this addon makes to the panel database, and every guard on it.
#
# It exists because `site:add:php` is the only site:add verb with a
# --vhostTemplate option, so for a static or reverse-proxy clone there is no
# clpctl route to carry the source's config -- see "Carrying a site's vhost to
# its clone" in docs/DECISIONS.md. What keeps it from being a hole:
#
#   - SITE_CREATED == 1. The row can only ever be one this job created seconds
#     ago; an adopted or pre-existing site is never written to.
#   - One UPDATE, one WHERE on a UNIQUE column, and a `type` that is one of
#     three literals, so the statement cannot touch a second row.
#   - $target has passed validate_domain, which is what makes interpolating it
#     into SQL safe: it holds nothing but [a-z0-9.-].
#   - Nothing a caller influenced is interpolated at all. The nginx body and the
#     application name both reach sqlite through readfile() from files this
#     function staged, so neither is ever escaped into a SQL string. The
#     application name used to be interpolated, and that was the hole: it
#     originates in the *source* site's `site.application`, which CloudPanel
#     fills from an unvalidated template name, so it could carry a payload into
#     both the UPDATE and the read-back -- and the read-back runs `sqlite3
#     -readonly`, where `writefile()` is still compiled in and root-owned.
#     application_ok now refuses such a name upstream; readfile() is what makes
#     the statement safe even if it ever got past that.
#   - runuser -u clp, not root. journal_mode is `delete`, so the write creates a
#     transient db.sq3-journal beside the database; made by root it is left
#     root-owned in a clp:clp 0770 directory and the panel cannot recover it.
#   - read back and compared before anything reports success.
PANEL_WRITE_REJECT=""

panel_update_site() {
  local target=$1 type=$2 application=$3 body_file=${4:-}
  PANEL_WRITE_REJECT=""

  if (( SITE_CREATED != 1 )); then
    PANEL_WRITE_REJECT="refusing to write the panel record of a site this job did not create"
    return 1
  fi
  if [[ ! -r $PANEL_DB ]]; then
    PANEL_WRITE_REJECT="the panel database is not readable"
    return 1
  fi
  # Refused here as well as where it was read, because this is the function that
  # puts it in a statement and a boundary should not depend on its callers.
  if ! application_ok "$application"; then
    PANEL_WRITE_REJECT="refusing to record '${application}' as the clone's application: not a name CloudPanel could have written"
    return 1
  fi
  if [[ -n $body_file && ! -f $body_file ]]; then
    PANEL_WRITE_REJECT="the composed vhost was not staged"
    return 1
  fi

  # The application name is handed to sqlite the same way the body is, so the
  # statement holds no caller-influenced text at all. That needs a file, and one
  # staging directory per call rather than a long-lived one: this is the only
  # thing in it, and a stage that outlives the statement is a root-owned
  # directory in /tmp waiting for a signal to strand it.
  local stage rc=0
  stage=$(make_clp_stage) || {
    PANEL_WRITE_REJECT="a staging directory for the panel write could not be created"
    return 1
  }
  panel_write_site "${stage}/application" "$target" "$type" "$application" "$body_file" || rc=1
  rm -rf "$stage"
  return $rc
}

# The statement itself, with both values already staged as files. Split out so
# panel_update_site owns the guards and the stage's lifetime, and this owns the
# SQL -- the same split as vhost_template_body and build_vhost_template, and for
# the same reason: the part with the rules in it should be readable on its own.
panel_write_site() {
  local app_file=$1 target=$2 type=$3 application=$4 body_file=$5

  # No trailing newline: this file is compared against a column, and printf '%s'
  # is what keeps the comparison a byte comparison rather than an off-by-one.
  printf '%s' "$application" > "$app_file" || {
    PANEL_WRITE_REJECT="the application name could not be staged"
    return 1
  }
  chown root:clp "$app_file" && chmod 640 "$app_file" || true

  local set_vhost=""
  if [[ -n $body_file ]]; then
    set_vhost="vhost_template = CAST(readfile('${body_file}') AS TEXT), "
  fi

  # stdout is discarded rather than logged: the sqlite3 CLI echoes a PRAGMA's
  # resulting value, so the busy_timeout would otherwise put a bare `5000` in
  # the job transcript. Errors go to stderr and are kept.
  if ! runuser -u clp -- sqlite3 "$PANEL_DB" \
       "PRAGMA busy_timeout=5000;
        UPDATE site
           SET ${set_vhost}application = CAST(readfile('${app_file}') AS TEXT),
               updated_at = datetime('now')
         WHERE domain_name = '${target}' AND type = '${type}';" >/dev/null; then
    PANEL_WRITE_REJECT="the panel database refused the update"
    return 1
  fi

  # Compared inside sqlite against the same files, so this is a byte comparison
  # of the columns rather than of two shell variables that command substitution
  # has already trimmed.
  local check
  if [[ -n $body_file ]]; then
    check=$(panel_query "SELECT CASE WHEN vhost_template = CAST(readfile('${body_file}') AS TEXT)
                                 AND application = CAST(readfile('${app_file}') AS TEXT) THEN 1 ELSE 0 END
                           FROM site WHERE domain_name = '${target}';") || check=""
  else
    check=$(panel_query "SELECT CASE WHEN application = CAST(readfile('${app_file}') AS TEXT) THEN 1 ELSE 0 END
                           FROM site WHERE domain_name = '${target}';") || check=""
  fi
  if [[ $check != "1" ]]; then
    PANEL_WRITE_REJECT="the panel record does not read back as it was written"
    return 1
  fi
  return 0
}

# Where the composed body and the clone's own pair are staged. Separate from
# TEMPLATE_STAGE because the two exist at different points in a clone -- the
# template is gone before the site is created, this appears afterwards -- and
# one variable for both would make the rollback unable to say what it is
# removing.
VHOST_STAGE=""

drop_vhost_stage() {
  [[ -n $VHOST_STAGE ]] || return 0
  rm -rf "$VHOST_STAGE"
  VHOST_STAGE=""
  return 0
}

# Set when the carry-over is refused, so the job can name the reason rather
# than leaving an operator to guess which of several conditions applied.
CARRY_REJECT=""

# Carry the source's vhost to a clone that already exists on its stock one.
#
# File first, and that ordering is the point. The rendered config is written and
# `nginx -t`-ed before the database is touched, so the row the panel would
# regenerate from is never left describing a config nginx rejected; and nothing
# is reloaded until both have succeeded, so a bad config is never served. Every
# failure restores the backup, which means the worst outcome is a working clone
# on the stock vhost plus a note saying why -- never a missing clone and never
# a broken nginx.
carry_vhost() {
  local source=$1 target=$2 type=$3 application=$4
  CARRY_REJECT=""

  local conf="${NGINX_VHOST_DIR}/${target}.conf"
  if [[ ! -f $conf ]]; then
    CARRY_REJECT="CloudPanel wrote no vhost file for the clone"
    return 1
  fi

  drop_vhost_stage
  VHOST_STAGE=$(make_clp_stage) || { CARRY_REJECT="a staging directory could not be created"; return 1; }
  local stock="${VHOST_STAGE}/stock.tpl"
  local body="${VHOST_STAGE}/body.tpl"
  local rendered="${VHOST_STAGE}/rendered.conf"
  local backup="${VHOST_STAGE}/backup.conf"

  # writefile() rather than a SELECT into a variable: the column is the half of
  # the pair the walk below measures against, and command substitution would
  # trim trailing newlines off one side of that comparison.
  if ! panel_query "SELECT writefile('${stock}', vhost_template) FROM site WHERE domain_name = '${target}';" >/dev/null \
     || [[ ! -s $stock ]]; then
    CARRY_REJECT="the clone's own stored vhost could not be read back"
    return 1
  fi
  chown root:clp "$stock" && chmod 640 "$stock" || true

  if ! learn_vhost_map "$stock" "$conf"; then
    CARRY_REJECT="$VHOST_MAP_REJECT"
    return 1
  fi

  local composed
  if ! composed=$(compose_vhost_body "$source" "$target"); then
    CARRY_REJECT="$VHOST_COMPOSE_REJECT"
    return 1
  fi
  # No trailing newline, because the panel does not write one. Every
  # panel-written `site.vhost_template` on this box ends with `}` -- all 31 rows
  # measured -- while the file it renders to ends with exactly one newline, and
  # learn_vhost_map compensates for precisely that asymmetry when it reads a pair
  # back. Storing the body with a newline therefore made this addon unable to
  # read its own output: `stg.demo.clp-stg.local`, the clone this implementation
  # produced, stored 10 as its last codepoint, and cloning it again refused with
  # "the rendered vhost does not end with the text after {{settings}}". Store
  # what the panel would store.
  printf '%s' "$composed" > "$body"
  chown root:clp "$body" && chmod 640 "$body" || true

  if ! vhost_body_ok "$body" "$source" "$target"; then
    CARRY_REJECT="$VHOST_REJECT"
    return 1
  fi

  if ! render_vhost_body "$composed" > "$rendered"; then
    CARRY_REJECT="$VHOST_MAP_REJECT"
    return 1
  fi
  # The newline learn_vhost_map accounted for on the way in, put back on the
  # way out, so the file the panel would write and the file written here differ
  # in nothing at all.
  printf '\n' >> "$rendered"

  cp -a "$conf" "$backup" || { CARRY_REJECT="the clone's vhost could not be backed up"; return 1; }

  # Restore and say why. Used by every failure path below, so there is one
  # implementation of "put the stock vhost back" rather than four.
  #
  # `row` for every path that runs after the UPDATE could have gone through, and
  # that is more paths than it looks. panel_update_site returning 1 from its
  # *read-back* means the UPDATE already ran and only the verification of it
  # failed -- so the one branch that runs after the row changed was the one
  # branch that put back only the file, leaving the row holding whatever the
  # failed write left there while the config on disk reverted to stock. The
  # panel regenerates the file from the row, so that is the disagreement the
  # file-first ordering exists to prevent, reached by the failure path instead of
  # the success path. The reload branch already restored both halves; the
  # asymmetry was backwards.
  local restore_note=""
  carry_restore() {
    cp "$backup" "$conf" && chown root:root "$conf" && chmod 644 "$conf" \
      || warn "could not restore the stock vhost for ${target}"
    if [[ ${1:-} == "row" ]]; then
      # The clone's own stock body, as the panel stored it moments ago, written
      # back through the same guarded path that wrote the carried one.
      panel_update_site "$target" "$type" "$application" "$stock" \
        || warn "the panel record for ${target} may still hold the carried vhost; check Site -> Vhost"
    fi
    CARRY_REJECT=$restore_note
  }

  if ! { cp "$rendered" "$conf" && chown root:root "$conf" && chmod 644 "$conf"; }; then
    restore_note="the carried vhost could not be written to ${conf}"
    carry_restore
    return 1
  fi

  # Captured rather than streamed. `nginx -t` reports every warning in every
  # vhost on the box -- sixty lines on this one -- which buries the clone's own
  # progress on the success path and buries the actual error on the failure one.
  local check_out=""
  if ! check_out=$(nginx -t 2>&1); then
    printf '%s\n' "$check_out" >&2
    restore_note="nginx rejected the carried config, so the clone keeps the stock one"
    carry_restore
    return 1
  fi

  if ! panel_update_site "$target" "$type" "$application" "$body"; then
    restore_note="$PANEL_WRITE_REJECT"
    carry_restore row
    return 1
  fi

  if ! systemctl reload nginx >&2; then
    # nginx -t passed, so this is exotic -- but the database now describes a
    # config that is not in service, which is the one direction the ordering
    # above exists to avoid. Put both halves back, in the same order.
    restore_note="nginx would not reload the carried config, so the clone keeps the stock one"
    carry_restore row
    systemctl reload nginx >&2 || warn "nginx did not reload after restoring ${target}"
    return 1
  fi

  # The stage is dropped by the caller, not here. A failed carry-over is not a
  # failed clone -- the job goes on with the stock vhost -- so the rollback trap
  # never runs, and a `return 1` that skipped the cleanup left a root-owned
  # directory in /tmp behind every refusal. Observed once, forcing nginx -t to
  # fail on a composed body.
  return 0
}

# --- cloning an Instatic instance -------------------------------------------
#
# A reverse-proxy site's backend is a port, so cloning the site alone gives a
# second hostname pointing at the *same* container -- a staging site that edits
# production content. Everything here exists to make that outcome unreachable:
# the backend is established as an Instatic instance this box manages before
# anything is created, the clone gets a container, a port and a master key of
# its own, and the content moves through Instatic's own site-bundle export and
# import rather than through its files.
#
# The bundle is the right transfer precisely because of what it leaves behind.
# It carries the site shell, data tables, rows, media, media folders and
# redirects -- and no users and no secrets. So the clone gets its own
# INSTATIC_SECRET_KEY, its own owner and its own sessions, and nothing encrypted
# at rest travels between the two instances. Reaching into an instance's data/
# and uploads/ instead would freeze this addon against one version of a schema
# it does not own and drag the source's key along with the content.

# Read one field out of an instance's record. The same shape the Instatic
# wrapper uses on its own files, because it is the same file.
instatic_meta() {
  local domain=$1 field=$2
  local file="${INSTATIC_DATA_DIR}/${domain}/meta.json"
  [[ -f $file ]] || return 1
  json_field "$file" "$field"
}

INSTATIC_REJECT=""
INSTATIC_PORT=""
INSTATIC_TAG=""

# Establish that a reverse-proxy site really is an Instatic instance of ours.
#
# Two facts, and both have to hold: the Instatic addon has a record for this
# hostname, and the panel's own reverse_proxy_url is that record's port on the
# loopback. Either alone is not enough -- a record can outlive a site that was
# repointed, and a loopback URL says nothing about what is listening on it.
instatic_backend_of() {
  local domain=$1 port tag url
  INSTATIC_REJECT=""
  INSTATIC_PORT=""
  INSTATIC_TAG=""

  if [[ ! -x $INSTATIC_WRAPPER ]]; then
    INSTATIC_REJECT="the Instatic addon is not installed on this server, so there is no supported way to duplicate the backend"
    return 1
  fi
  if [[ ! -f "${INSTATIC_DATA_DIR}/${domain}/meta.json" ]]; then
    INSTATIC_REJECT="its backend is not an Instatic instance this box manages; cloning would point the staging hostname at the live application"
    return 1
  fi

  port=$(instatic_meta "$domain" port) || port=""
  tag=$(instatic_meta "$domain" tag) || tag=""
  if [[ ! $port =~ ^[0-9]{1,5}$ ]] || [[ ! $tag =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    INSTATIC_REJECT="the Instatic record for ${domain} is incomplete"
    return 1
  fi

  url=$(reverse_proxy_url_of "$domain") || url=""
  if [[ $url != "http://127.0.0.1:${port}" ]]; then
    INSTATIC_REJECT="it proxies '${url}' rather than the Instatic instance recorded for it; cloning would point the staging hostname at whatever that is"
    return 1
  fi

  INSTATIC_PORT=$port
  INSTATIC_TAG=$tag
  return 0
}

# Instatic's admin API, over the loopback port the instance publishes.
#
# Three details decide whether these work at all. Instatic runs a CSRF origin
# check on every mutating method against its configured PUBLIC_ORIGIN, and these
# requests arrive on 127.0.0.1 rather than on the hostname, so each one carries
# an explicit Origin header naming the real one. The session rides in a curl
# cookie jar rather than in a cookie name written down here, because the name is
# Instatic's to change. And no credential is ever an argument: request bodies
# are written to a 0600 file in the job directory and handed to curl as @file,
# because anything in argv is readable out of ps by every account on the box.
#
# `|| true` on the curl: -w prints 000 for a request that never got a response,
# which is the failure the caller has to see. Letting the non-zero exit abort
# the assignment under set -e would report it as nothing at all.
instatic_post() {
  local port=$1 domain=$2 jar=$3 path=$4 ctype=$5 req=$6 out=$7
  new_secret_file "$out"
  curl -sS --max-time 900 -o "$out" -w '%{http_code}' \
    -c "$jar" -b "$jar" \
    -X POST "http://127.0.0.1:${port}${path}" \
    -H "Origin: https://${domain}" \
    -H "Content-Type: ${ctype}" \
    --data-binary "@${req}" || true
}

instatic_get() {
  local port=$1 domain=$2 jar=$3 path=$4 out=$5
  new_secret_file "$out"
  curl -sS --max-time 900 -o "$out" -w '%{http_code}' \
    -c "$jar" -b "$jar" \
    "http://127.0.0.1:${port}${path}" \
    -H "Origin: https://${domain}" || true
}

# A file curl is about to create, made empty and 0600 first.
#
# curl writes its output file and its cookie jar with the process umask, and
# `cmd_run` inherits the unit's UMask=0022 -- so a live session token and a full
# export of a customer's site landed as 0644 while every other secret in that
# directory is 0600. The export stayed that way for the whole download, because
# the chmod only ran once curl had finished. Both `-o` and `-c` truncate an
# existing file rather than recreating it, so the mode set here is the mode they
# keep. The 0700 job directory is the other half of this; a mode is not a
# substitute for it, and it is not a substitute for a mode.
new_secret_file() {
  local f=$1
  rm -f "$f"
  ( umask 077; : > "$f" )
  chmod 600 "$f"
  return 0
}

# Write a JSON request body without any of it passing through argv. printf is a
# shell builtin, so the value never becomes a process argument even for an
# instant.
instatic_body() {
  local file=$1 json=$2
  ( umask 077; printf '%s' "$json" > "$file" )
  chmod 600 "$file"
}

# The reason a request failed, as Instatic reported it, for the job's log.
instatic_error() {
  local out=$1
  local msg
  msg=$(head -c 400 "$out" 2>/dev/null | tr -d '\000-\037') || msg=""
  printf '%s' "${msg:-no response body}"
}

# Open a session on an instance. Returns 0 with the jar populated.
#
# MFA is not optional to handle: a source owner with it enabled gets a pending
# session out of /login and a 401 out of everything else, which without this
# would surface as "export refused" and send the operator looking at
# capabilities. The code is asked for up front instead, and its absence is a
# failure before anything is created.
instatic_login() {
  local port=$1 domain=$2 jar=$3 email=$4 password=$5 mfa=$6 what=$7
  local req="${JOB_DIR}/.api-req" out="${JOB_DIR}/.api-out" code
  INSTATIC_REJECT=""

  # The jar starts here, so this is where its mode is set. Every later call
  # passes -b as well as -c and must not truncate it.
  new_secret_file "$jar"
  instatic_body "$req" "$(printf '{"email":%s,"password":%s}' "$(json_str "$email")" "$(json_str "$password")")"
  code=$(instatic_post "$port" "$domain" "$jar" "/admin/api/cms/login" "application/json" "$req" "$out")
  rm -f "$req"
  if [[ $code != "200" ]]; then
    INSTATIC_REJECT="${what} refused the login (HTTP ${code}): $(instatic_error "$out")"
    rm -f "$out"
    return 1
  fi

  if grep -q '"mfaRequired":true' "$out"; then
    if [[ -z $mfa ]]; then
      INSTATIC_REJECT="${what} has multi-factor authentication enabled and no authentication code was supplied"
      rm -f "$out"
      return 1
    fi
    instatic_body "$req" "$(printf '{"code":%s}' "$(json_str "$mfa")")"
    code=$(instatic_post "$port" "$domain" "$jar" "/admin/api/cms/auth/mfa/verify" "application/json" "$req" "$out")
    rm -f "$req"
    if [[ $code != "200" ]]; then
      INSTATIC_REJECT="${what} rejected the authentication code (HTTP ${code}): $(instatic_error "$out")"
      rm -f "$out"
      return 1
    fi
  fi
  rm -f "$out"
  return 0
}

# Revoked rather than left to expire. A clone should not leave a live session
# behind on the site it copied.
instatic_logout() {
  local port=$1 domain=$2 jar=$3
  local req="${JOB_DIR}/.api-req" out="${JOB_DIR}/.api-out"
  [[ -f $jar ]] || return 0
  instatic_body "$req" "{}"
  instatic_post "$port" "$domain" "$jar" "/admin/api/cms/logout" "application/json" "$req" "$out" >/dev/null
  rm -f "$req" "$out" "$jar"
  return 0
}

# Open the step-up window `strategy=replace` requires.
#
# replace wipes every data row before reinserting, which Instatic treats as the
# highest-blast-radius operation it has: data.import plus content.manage plus a
# step-up window no older than the policy allows. Nothing else gives a clone
# that matches its source rather than merely containing it -- the setup step
# seeds a starter homepage, and a merge would leave it behind.
instatic_step_up() {
  local port=$1 domain=$2 jar=$3 password=$4 mfa=$5
  local req="${JOB_DIR}/.api-req" out="${JOB_DIR}/.api-out" code
  INSTATIC_REJECT=""

  if [[ -n $mfa ]]; then
    instatic_body "$req" "$(printf '{"password":%s,"mfaCode":%s}' "$(json_str "$password")" "$(json_str "$mfa")")"
  else
    instatic_body "$req" "$(printf '{"password":%s}' "$(json_str "$password")")"
  fi
  code=$(instatic_post "$port" "$domain" "$jar" "/admin/api/cms/auth/step-up" "application/json" "$req" "$out")
  rm -f "$req"
  if [[ $code != "200" ]]; then
    INSTATIC_REJECT="the clone refused to open a step-up window (HTTP ${code}): $(instatic_error "$out")"
    rm -f "$out"
    return 1
  fi
  rm -f "$out"
  return 0
}

# Bootstrap the clone's first owner through the public one-shot setup endpoint.
#
# Public because it 409s once anyone has run it, which is what keeps it from
# being an account-creation backdoor -- and what makes it usable here exactly
# once, on an instance that booted seconds ago with an empty database.
instatic_setup() {
  local port=$1 domain=$2 jar=$3 email=$4 password=$5 site_name=$6
  local req="${JOB_DIR}/.api-req" out="${JOB_DIR}/.api-out" code
  INSTATIC_REJECT=""

  # The first call on the clone's own jar, so the same rule applies here.
  new_secret_file "$jar"

  instatic_body "$req" "$(printf '{"siteName":%s,"email":%s,"password":%s}' \
    "$(json_str "$site_name")" "$(json_str "$email")" "$(json_str "$password")")"
  code=$(instatic_post "$port" "$domain" "$jar" "/admin/api/cms/setup" "application/json" "$req" "$out")
  rm -f "$req"
  if [[ $code != "201" ]]; then
    INSTATIC_REJECT="the clone would not bootstrap its owner (HTTP ${code}): $(instatic_error "$out")"
    rm -f "$out"
    return 1
  fi
  rm -f "$out"
  return 0
}

# --- verbs ------------------------------------------------------------------

# The SQL fragment that keeps the type gate in one place. Every value in it is
# a literal from CLONABLE_TYPES, never anything a caller supplied.
clonable_types_sql() {
  local t out=""
  for t in "${CLONABLE_TYPES[@]}"; do
    [[ -z $out ]] || out+=","
    out+="'${t}'"
  done
  printf '%s' "$out"
}

cmd_sites() {
  local rows out="" first=1
  # LEFT JOIN rather than JOIN: a static or reverse-proxy site has no
  # php_settings row, and an inner join is what used to make the list PHP-only
  # even after the type filter came off.
  rows=$(panel_query "
    SELECT s.domain_name, s.type, s.user, COALESCE(p.php_version, ''), COALESCE(s.application, ''),
           (SELECT COUNT(*) FROM database d WHERE d.site_id = s.id)
      FROM site s LEFT JOIN php_settings p ON p.site_id = s.id
     WHERE s.type IN ($(clonable_types_sql))
     ORDER BY s.domain_name;") || emit_err "cannot read the panel database"

  local domain type user php app dbs
  while IFS='|' read -r domain type user php app dbs; do
    [[ -n $domain ]] || continue
    # A reverse-proxy site is only clonable when its backend is an Instatic
    # instance this box manages. Offering the others in a list headed "which
    # site should be cloned?" would be offering something that can only answer
    # with a refusal -- including the addon's own site.
    if [[ $type == "reverse-proxy" ]] && ! instatic_backend_of "$domain"; then continue; fi
    (( first == 1 )) || out+=","
    out+=$(printf '{"domain":%s,"siteType":%s,"siteUser":%s,"phpVersion":%s,"application":%s,"databases":%d}' \
      "$(json_str "$domain")" "$(json_str "$type")" "$(json_str "$user")" "$(json_str "$php")" \
      "$(json_str "$app")" "${dbs:-0}")
    first=0
  done <<< "$rows"

  emit_ok "{\"sites\":[${out}]}"
}

cmd_describe() {
  local domain=$1 row type user root app php="" db size instatic="false"
  row=$(site_row "$domain") || emit_err "cannot read the panel database"
  [[ -n $row ]] || emit_err "no CloudPanel site for ${domain}"
  IFS='|' read -r type user root app <<< "$row"
  type_is_clonable "$type" \
    || emit_err "${domain} is a '${type}' site; only ${CLONABLE_TYPES[*]} sites can be cloned"

  if [[ $type == "reverse-proxy" ]]; then
    instatic_backend_of "$domain" || emit_err "${domain} cannot be cloned: ${INSTATIC_REJECT}"
    instatic="true"
  fi
  if [[ $type == "php" ]]; then php=$(php_version_of "$domain"); fi
  db=$(database_of "$domain")
  size=0
  if [[ -d "/home/${user}/htdocs/${domain}" ]]; then
    size=$(du -sm "/home/${user}/htdocs/${domain}" 2>/dev/null | cut -f1) || size=0
  fi
  [[ $size =~ ^[0-9]+$ ]] || size=0

  emit_ok "$(printf '{"domain":%s,"siteType":%s,"instatic":%s,"siteUser":%s,"phpVersion":%s,"application":%s,"rootDirectory":%s,"database":%s,"sizeMb":%d}' \
    "$(json_str "$domain")" "$(json_str "$type")" "$instatic" \
    "$(json_str "$user")" "$(json_str "$php")" \
    "$(json_str "${app:-Generic}")" "$(json_str "$root")" "$(json_str "$db")" "$size")"
}

cmd_clone() {
  local source=$1 target=$2 tls=$3 port=$4 email=$5

  [[ $source != "$target" ]] || emit_err "the source and the target are the same site"
  site_exists "$source" || emit_err "no CloudPanel site for ${source}"
  ! site_exists "$target" || emit_err "a CloudPanel site for ${target} already exists"

  local row type
  row=$(site_row "$source") || emit_err "cannot read the panel database"
  IFS='|' read -r type _ _ _ <<< "$row"
  type_is_clonable "$type" \
    || emit_err "${source} is a '${type}' site; only ${CLONABLE_TYPES[*]} sites can be cloned"

  # An Instatic clone needs three things the others do not, and all three are
  # settled here rather than inside the job: a refusal that arrives minutes
  # later, after a job record exists and a page has been polling it, reads as a
  # failed clone rather than as a request that was never going to work.
  local password="" mfa=""
  if [[ $type == "reverse-proxy" ]]; then
    instatic_backend_of "$source" || emit_err "${source} cannot be cloned: ${INSTATIC_REJECT}"
    [[ -n $port ]]  || emit_err "cloning an Instatic site needs --port for the clone's own instance"
    [[ -n $email ]] || emit_err "cloning an Instatic site needs --email for the source instance's admin account"
    # Both secrets on stdin, never in argv. An argument is readable out of `ps`
    # by every account on this box for as long as the process lives, and worse
    # than that here: `sudo` journals this wrapper's whole COMMAND line --
    # verified against this box's own journal -- so `--mfa` wrote the code into
    # the persistent journal. validate_mfa deliberately accepts a *recovery*
    # code, and a recovery code does not expire.
    #
    # One per line, the password first. The whole of stdin rather than one
    # `read`: `IFS= read -r` stops at the first newline, so a password
    # containing one arrived here silently shortened and produced a 401 --
    # spending the production account's lockout budget on a value the operator
    # never typed. The `x` survives command substitution's newline strip so that
    # only the terminator the caller adds is removed, and line framing is sound
    # only because a newline inside either secret is refused rather than trimmed.
    local supplied
    supplied=$(cat; printf x) || true
    supplied=${supplied%x}
    supplied=${supplied%$'\n'}
    password=${supplied%%$'\n'*}
    if [[ $supplied == *$'\n'* ]]; then mfa=${supplied#*$'\n'}; fi
    supplied=""
    [[ -n $password ]] || emit_err "cloning an Instatic site needs the source instance's admin password on stdin"
    (( ${#password} <= 256 )) || emit_err "the password is too long"
    if [[ -n $mfa ]]; then
      [[ $mfa != *$'\n'* ]] || emit_err "stdin holds more than a password and an authentication code"
      validate_mfa "$mfa"
    fi
  else
    if [[ -n $port || -n $email ]]; then
      emit_err "--port and --email apply only to cloning an Instatic site"
    fi
  fi

  local stg_user; stg_user=$(site_user_for "$target")
  ! user_taken "$stg_user" || emit_err "the site user ${stg_user} already exists; ${target} may be half-created"

  # An unfinished job for the same target means a clone is already in flight.
  local existing
  for existing in "$JOBS_DIR"/*/; do
    [[ -d $existing ]] || continue
    [[ $(job_get "${existing%/}" target) == "$target" ]] || continue
    local st; st=$(job_get "${existing%/}" state)
    [[ $st == "queued" || $st == "running" ]] \
      && emit_err "a clone into ${target} is already ${st}"
  done

  local id dir
  id=$(new_job_id)
  dir=$(job_dir "$id")
  mkdir -p "$dir"
  chmod 700 "$dir"

  job_set "$dir" source "$source"
  job_set "$dir" target "$target"
  job_set "$dir" tls "$tls"
  if [[ -n $port ]];  then job_set "$dir" port "$port"; fi
  if [[ -n $email ]]; then job_set "$dir" email "$email"; fi
  # Both credentials land as files, 0600 in a 0700 root directory like the
  # database dump, and both are deleted by the job the moment the sign-in they
  # exist for has succeeded. `run` is started by systemd and inherits no stdin,
  # so a file is the only way either can reach it -- and it is why the record is
  # a file rather than an argument. Nothing used to delete the authentication
  # code at all, so it survived JOB_RETENTION_DAYS in a record that is kept
  # precisely because it holds a credential the panel cannot show again.
  if [[ -n $mfa ]];      then job_set "$dir" mfa "$mfa"; fi
  if [[ -n $password ]]; then job_set "$dir" srcPassword "$password"; fi
  job_set "$dir" createdAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  job_set "$dir" step "queued"
  job_set "$dir" state queued
  : > "${dir}/log"
  chmod 600 "${dir}/log"

  # The lock goes before the job starts, not after. `run` takes the same lock
  # for the length of the clone, and holding it here while waiting on systemd
  # deadlocked the two against each other: the job sat blocked on flock until
  # its timeout, failed, and the failure was reported as systemd refusing to
  # start it.
  exec 200>&-

  # A transient unit rather than a background subshell. The app is a systemd
  # service, so anything it forks lives in that service's cgroup and dies with
  # it -- and the unit has Restart=always. A clone of a large site takes long
  # enough that a restart during one is not hypothetical, and it would leave a
  # site half built. systemd-run asks PID 1 to start the work in a cgroup of
  # its own, where nothing this addon does can interrupt it.
  #
  # Type=exec rather than oneshot: with oneshot, systemd-run waits for the whole
  # clone to finish, which is the opposite of what this verb is for. Type=exec
  # returns as soon as the job has been exec'd successfully, so a job that could
  # not be started at all is still reported here rather than sitting in the
  # queue forever.
  if ! systemd-run \
        --unit="clp-addon-stager-job-${id}" \
        --description="clp-addons: cloning ${source} into ${target}" \
        --collect \
        --property=Type=exec \
        -- "$SELF" run --job "$id" >&2; then
    job_set "$dir" error "could not start the clone job"
    job_set "$dir" state failed
    # The credentials go with the job that will never run them. This path
    # marked the record failed and left them on disk, where `prune` keeps a
    # failed record for JOB_RETENTION_DAYS -- so a job that never started was
    # the one way another site's administrator password outlived the request
    # that carried it.
    rm -f "${dir}/srcPassword" "${dir}/mfa"
    emit_err "systemd-run refused to start the clone job"
  fi

  emit_ok "$(printf '{"job":%s,"source":%s,"target":%s}' \
    "$(json_str "$id")" "$(json_str "$source")" "$(json_str "$target")")"
}

job_json() {
  local dir=$1 id=$2 result port
  result=$(cat "${dir}/result.json" 2>/dev/null || true)
  [[ -n $result ]] || result="null"
  # Reported so the app can keep a second Instatic clone off a port the first
  # one has taken but the panel snapshot does not know about yet. Emitted as a
  # JSON number, so a record without one has to read 0 rather than nothing --
  # `"port":,` would make the whole reply unparseable and empty the dashboard.
  port=$(job_get "$dir" port)
  [[ $port =~ ^[0-9]+$ ]] || port=0
  printf '{"id":%s,"source":%s,"target":%s,"port":%d,"state":%s,"step":%s,"error":%s,"createdAt":%s,"startedAt":%s,"finishedAt":%s,"result":%s}' \
    "$(json_str "$id")" \
    "$(json_str "$(job_get "$dir" source)")" \
    "$(json_str "$(job_get "$dir" target)")" \
    "$port" \
    "$(json_str "$(job_get "$dir" state)")" \
    "$(json_str "$(job_get "$dir" step)")" \
    "$(json_str "$(job_get "$dir" error)")" \
    "$(json_str "$(job_get "$dir" createdAt)")" \
    "$(json_str "$(job_get "$dir" startedAt)")" \
    "$(json_str "$(job_get "$dir" finishedAt)")" \
    "$result"
}

cmd_job() {
  local id=$1 dir
  dir=$(job_dir "$id")
  [[ -d $dir ]] || emit_err "no such job: ${id}"
  local body tail_log
  body=$(job_json "$dir" "$id")
  tail_log=$(tail -n "$LOG_TAIL_LINES" "${dir}/log" 2>/dev/null || true)
  printf '{"ok":true,"data":{"job":%s,"log":%s}}\n' "$body" "$(json_str "$tail_log")"
}

cmd_jobs() {
  local out="" first=1 dir id
  # Newest first: the id starts with a UTC timestamp, so a reverse sort of the
  # directory names is a reverse sort by time.
  for dir in $(ls -1 "$JOBS_DIR" 2>/dev/null | sort -r); do
    [[ -d "${JOBS_DIR}/${dir}" ]] || continue
    [[ $dir =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$ ]] || continue
    id=$dir
    (( first == 1 )) || out+=","
    out+=$(job_json "${JOBS_DIR}/${dir}" "$id")
    first=0
  done
  emit_ok "{\"jobs\":[${out}]}"
}

cmd_prune() {
  local removed=0 dir state
  for dir in "$JOBS_DIR"/*/; do
    [[ -d $dir ]] || continue
    state=$(job_get "${dir%/}" state)
    # Never touch work in flight, however old the record looks.
    [[ $state == "queued" || $state == "running" ]] && continue
    if [[ -n $(find "$dir" -maxdepth 0 -mtime "+${JOB_RETENTION_DAYS}" 2>/dev/null) ]]; then
      rm -rf "$dir"
      removed=$((removed + 1))
    fi
  done
  emit_ok "{\"removed\":${removed}}"
}

# --- argument parsing -------------------------------------------------------
# Parsed and validated in full before anything is created, locked, or touched.

(( $# >= 1 )) || emit_err "usage: $0 {sites|describe|clone|run|job|jobs|prune} [options]"

VERB=$1; shift

SOURCE=""; TARGET=""; DOMAIN=""; JOB=""; TLS="no"; PORT=""; EMAIL=""
while (( $# > 0 )); do
  case $1 in
    --source) [[ $# -ge 2 ]] || emit_err "--source needs a value"; SOURCE=$2; shift 2 ;;
    --target) [[ $# -ge 2 ]] || emit_err "--target needs a value"; TARGET=$2; shift 2 ;;
    --domain) [[ $# -ge 2 ]] || emit_err "--domain needs a value"; DOMAIN=$2; shift 2 ;;
    --job)    [[ $# -ge 2 ]] || emit_err "--job needs a value";    JOB=$2;    shift 2 ;;
    --tls)    [[ $# -ge 2 ]] || emit_err "--tls needs a value";    TLS=$2;    shift 2 ;;
    --port)   [[ $# -ge 2 ]] || emit_err "--port needs a value";   PORT=$2;   shift 2 ;;
    --email)  [[ $# -ge 2 ]] || emit_err "--email needs a value";  EMAIL=$2;  shift 2 ;;
    *) emit_err "unknown argument: '$1'" ;;
  esac
done

# There is deliberately no --password and no --mfa. Both credentials this
# wrapper takes arrive on stdin, one per line, because an argument is visible in
# ps to every account on the box for as long as the process lives -- and because
# sudo journals this wrapper's whole COMMAND line, so an argument outlives the
# process entirely. The authentication code was in argv until that was measured
# against this box's own journal; validate_mfa accepts a recovery code, and a
# recovery code does not expire.

case $VERB in
  sites|jobs|prune) ;;
  describe)         validate_domain "$DOMAIN" domain ;;
  clone)            validate_domain "$SOURCE" source; validate_domain "$TARGET" target
                    validate_flag "$TLS" tls
                    if [[ -n $PORT ]];  then validate_port "$PORT";   fi
                    if [[ -n $EMAIL ]]; then validate_email "$EMAIL"; fi ;;
  run|job)          validate_job "$JOB" ;;
  *) emit_err "unknown verb: '$VERB'" ;;
esac

# Reject arguments the verb does not take, so a typo cannot be silently ignored.
case $VERB in
  clone) if [[ -n $DOMAIN || -n $JOB ]]; then emit_err "clone takes --source, --target, --tls and, for an Instatic site, --port and --email"; fi ;;
  describe) if [[ -n $SOURCE || -n $TARGET || -n $JOB || $TLS != "no" || -n $PORT || -n $EMAIL ]]; then emit_err "describe takes only --domain"; fi ;;
  run|job) if [[ -n $SOURCE || -n $TARGET || -n $DOMAIN || $TLS != "no" || -n $PORT || -n $EMAIL ]]; then emit_err "${VERB} takes only --job"; fi ;;
  sites|jobs|prune)
    if [[ -n $SOURCE || -n $TARGET || -n $DOMAIN || -n $JOB || $TLS != "no" || -n $PORT || -n $EMAIL ]]; then
      emit_err "${VERB} takes no arguments"
    fi ;;
esac

mkdir -p "$LOCK_DIR" "$JOBS_DIR"
# The addon's state directory itself belongs to the installer, which owns it by
# the app's site user; setting a mode here too would have the two overwrite each
# other every time the reconciliation timer runs. Job records are what hold
# secrets, and this is the directory that keeps them from every other account.
chmod 700 "$LOCK_DIR" "$JOBS_DIR"

# One lock per target domain, held for the whole run, so two clones cannot
# build the same site at once. The read-only verbs take none: they would
# otherwise stop answering for the whole length of a clone, which is exactly
# when someone is watching.
case $VERB in
  clone)
    exec 200>"${LOCK_DIR}/stager-${TARGET}.lock"
    flock -w 30 200 || emit_err "another operation is already running for ${TARGET}" ;;
  run)
    LOCK_TARGET=$(job_get "$(job_dir "$JOB")" target)
    if [[ -n $LOCK_TARGET ]]; then
      # Validated before it becomes a path, not after. cmd_run re-validates the
      # job record, but the lock is taken first, so this value reached a path
      # root creates while it was still only "whatever the file said". The rule
      # the instatic wrapper states for its own lock -- derive it only from an
      # already-validated domain -- applies to a value read back off disk just
      # as much as to one that arrived in argv.
      validate_domain "$LOCK_TARGET" target
      exec 200>"${LOCK_DIR}/stager-${LOCK_TARGET}.lock"
      flock -w 30 200 || emit_err "another operation is already running for ${LOCK_TARGET}"
    fi ;;
esac

case $VERB in
  sites)    cmd_sites ;;
  describe) cmd_describe "$DOMAIN" ;;
  clone)    cmd_clone "$SOURCE" "$TARGET" "$TLS" "$PORT" "$EMAIL" ;;
  run)      cmd_run "$JOB" ;;
  job)      cmd_job "$JOB" ;;
  jobs)     cmd_jobs ;;
  prune)    cmd_prune ;;
esac
